@model IEnumerable<BLL.DTOs.UserDTO>

@{
    ViewData["Title"] = L["Users"];
    ViewData["NoIndex"] = true;
    var currentAdminEmail = ViewBag.CurrentAdminEmail as string;
}

<div class="container py-4 py-lg-5">
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
        <h1 class="page-title mb-0">@L["Users"]</h1>
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-person-plus"></i> @L["Add user"]</a>
    </div>

    <form asp-action="AllUser" method="post" class="search-panel mb-4">
        <div class="input-group">
            <input type="text" name="searchTerm" class="form-control" placeholder="@L["Search by name or email"]" aria-label="@L["Search by name or email"]" />
            <button type="submit" class="btn btn-primary"><i class="bi bi-search"></i> @L["Search"]</button>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-clean">
            <thead>
                <tr>
                    <th>@L["Name"]</th>
                    <th>@L["Email"]</th>
                    <th>@L["Role"]</th>
                    <th>@L["Joined"]</th>
                    <th class="text-end">@L["Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-semibold">@item.Name</td>
                        <td>@item.Email</td>
                        <td><span class="badge text-bg-secondary">@L[AppRoles.Name(item.RoleId)]</span></td>
                        <td class="text-nowrap">@item.CreatedAt.ToString("d MMM yyyy")</td>
                        <td class="text-end text-nowrap">
                            @if (!string.Equals(item.Email, currentAdminEmail, StringComparison.OrdinalIgnoreCase))
                            {
                                <a asp-action="Edit" asp-route-id="@item.UserId" class="btn btn-sm btn-outline-secondary">@L["Edit"]</a>
                                <a asp-action="Delete" asp-route-id="@item.UserId" class="btn btn-sm btn-link text-danger">@L["Delete"]</a>
                            }
                            else
                            {
                                <span class="meta">@L["You"]</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
