@using BLL.Audit
@model List<BLL.DTOs.AuditEntryDTO>

@{
    var type = ViewBag.Type as string;
    var userFilter = ViewBag.UserFilter as int?;
    var userFilterName = ViewBag.UserFilterName as string;
    var page = (int)ViewBag.Page;
    var pageSize = (int)ViewBag.PageSize;
    var total = (int)ViewBag.Total;
    var totalPages = (int)Math.Ceiling(total / (double)pageSize);
    ViewData["Title"] = L["Audit log"];
    ViewData["NoIndex"] = true;

    var labels = new Dictionary<string, string>
    {
        [AuditActions.ArticlePublished] = "Published an article",
        [AuditActions.ArticleApproved] = "Approved an article",
        [AuditActions.ArticleScheduled] = "Scheduled an article",
        [AuditActions.ArticleRejected] = "Rejected an article",
        [AuditActions.ArticlePublishedEarly] = "Published a scheduled article early",
        [AuditActions.ArticleUnscheduled] = "Cancelled a schedule",
        [AuditActions.ArticlePublishedOnSchedule] = "Scheduled articles went live",
        [AuditActions.ArticleEdited] = "Edited an article",
        [AuditActions.ArticleDeleted] = "Deleted an article",
        [AuditActions.CommentHidden] = "Hid a comment",
        [AuditActions.CommentAutoHidden] = "Comment hidden after reports",
        [AuditActions.CommentKept] = "Kept a reported comment",
        [AuditActions.CommentRemoved] = "Removed a comment",
        [AuditActions.UserCreated] = "Created a user",
        [AuditActions.UserUpdated] = "Updated a user",
        [AuditActions.UserRoleChanged] = "Changed a role",
        [AuditActions.UserDeleted] = "Deleted a user",
        [AuditActions.SectionCreated] = "Created a section",
        [AuditActions.SectionUpdated] = "Updated a section",
        [AuditActions.SectionDeleted] = "Deleted a section",
        [AuditActions.TagCreated] = "Created a tag",
        [AuditActions.TagUpdated] = "Updated a tag",
        [AuditActions.TagDeleted] = "Deleted a tag",
        [AuditActions.SignedIn] = "Signed in",
        [AuditActions.SignInFailed] = "Failed sign-in",
        [AuditActions.PasswordChanged] = "Changed password",
        [AuditActions.AllSessionsRevoked] = "Signed out everywhere",
        [AuditActions.AccountRegistered] = "Created an account",
        [AuditActions.PasswordResetRequested] = "Asked for a password reset code",
        [AuditActions.NewsletterSent] = "Sent the newsletter",
        [AuditActions.SubscriberRemoved] = "Removed a subscriber"
    };
    var warning = new HashSet<string> { AuditActions.SignInFailed, AuditActions.ArticleDeleted, AuditActions.UserDeleted, AuditActions.SectionDeleted, AuditActions.TagDeleted, AuditActions.CommentRemoved, AuditActions.UserRoleChanged };
    var typeLabels = new Dictionary<string, string>
    {
        [AuditEntities.Article] = "Articles",
        [AuditEntities.Comment] = "Comments",
        [AuditEntities.User] = "Users",
        [AuditEntities.Section] = "Sections",
        [AuditEntities.Tag] = "Topics",
        [AuditEntities.Newsletter] = "Newsletter",
        [AuditEntities.Security] = "Security"
    };
    string Link(string? t, int? u, int p = 1) => Url.Action("Audit", new { type = t, user = u, page = p > 1 ? p : (int?)null })!;
}

<div class="container py-4 py-lg-5">
    <header class="mb-4">
        <h1 class="page-title"><i class="bi bi-journal-text text-accent" aria-hidden="true"></i> @L["Audit log"]</h1>
        <p class="page-intro mb-0">@L["Every editorial, moderation, account and sign-in action, newest first. Entries are kept for {0} days.", AuditRules.RetentionDays]</p>
    </header>

    <nav class="audit-filters d-flex flex-wrap gap-2 mb-3" aria-label="@L["Filter"]">
        <a class="tag-chip @(type == null ? "is-active" : "")" href="@Link(null, userFilter)" aria-current="@(type == null ? "page" : null)">@L["All"]</a>
        @foreach (var t in AuditEntities.All)
        {
            <a class="tag-chip @(type == t ? "is-active" : "")" href="@Link(t, userFilter)" aria-current="@(type == t ? "page" : null)">@L[typeLabels[t]]</a>
        }
    </nav>

    @if (userFilter.HasValue)
    {
        <p class="small mb-3">
            @L["Showing actions by {0}.", userFilterName ?? "#" + userFilter]
            <a href="@Link(type, null)">@L["Show everyone"]</a>
        </p>
    }

    <p class="small text-muted">@L["{0} entries", total]</p>

    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <i class="bi bi-journal"></i>
            <h2 class="h5 mt-3">@L["Nothing recorded yet"]</h2>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle audit-table">
                <thead>
                    <tr>
                        <th scope="col">@L["When"]</th>
                        <th scope="col">@L["Who"]</th>
                        <th scope="col">@L["Action"]</th>
                        <th scope="col">@L["Details"]</th>
                        <th scope="col">@L["IP address"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in Model)
                    {
                        <tr>
                            <td class="text-nowrap small"><time datetime="@e.CreatedAt.ToString("yyyy-MM-ddTHH:mm:ss")">@e.CreatedAt.ToString("d MMM yyyy, h:mm tt")</time></td>
                            <td class="small">
                                @if (e.UserId.HasValue)
                                {
                                    <a href="@Link(type, e.UserId)">@(e.UserName ?? "#" + e.UserId)</a>
                                }
                                else
                                {
                                    <span class="text-muted">@L["System"]</span>
                                }
                            </td>
                            <td>
                                <span class="audit-action @(warning.Contains(e.Action) ? "is-warning" : "")">@L[labels.TryGetValue(e.Action, out var label) ? label : e.Action]</span>
                                @if (e.EntityId.HasValue && e.EntityType == AuditEntities.Article && e.Action != AuditActions.ArticleDeleted)
                                {
                                    <a class="small ms-1" href="/news/@e.EntityId">#@e.EntityId</a>
                                }
                                else if (e.EntityId.HasValue)
                                {
                                    <span class="small text-muted ms-1">#@e.EntityId</span>
                                }
                            </td>
                            <td class="small audit-details">@e.Details</td>
                            <td class="small text-muted text-nowrap">@e.IpAddress</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (totalPages > 1)
    {
        <nav class="mt-4" aria-label="@L["Pages"]">
            <ul class="pagination justify-content-center flex-wrap">
                @for (var i = Math.Max(1, page - 4); i <= Math.Min(totalPages, page + 4); i++)
                {
                    <li class="page-item @(i == page ? "active" : "")"><a class="page-link" href="@Link(type, userFilter, i)" aria-current="@(i == page ? "page" : null)">@i</a></li>
                }
            </ul>
        </nav>
    }
</div>
