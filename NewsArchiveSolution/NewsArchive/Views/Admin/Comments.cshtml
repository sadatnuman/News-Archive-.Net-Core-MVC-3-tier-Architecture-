@model List<BLL.DTOs.ModerationItemDTO>

@{
    var tab = (string)ViewBag.Tab;
    var page = (int)ViewBag.Page;
    var pageSize = (int)ViewBag.PageSize;
    var total = (int)ViewBag.Total;
    var reportedCount = (int)ViewBag.ReportedCount;
    var totalPages = (int)Math.Ceiling(total / (double)pageSize);
    var hiddenTab = tab == "hidden";
    ViewData["Title"] = L["Comment moderation"];
    ViewData["NoIndex"] = true;
    string TabUrl(string t, int p = 1) => Url.Action("Comments", new { tab = t == "reported" ? null : t, page = p > 1 ? p : (int?)null })!;
    string Here() => TabUrl(tab, page);
}

<div class="container py-4 py-lg-5">
    <header class="mb-4">
        <h1 class="page-title"><i class="bi bi-shield-check text-accent" aria-hidden="true"></i> @L["Comment moderation"]</h1>
        <p class="page-intro mb-0">@L["Comments reported {0} times are hidden automatically until you review them.", ModerationRules.AutoHideThreshold]</p>
    </header>

    <ul class="nav nav-tabs mb-4">
        <li class="nav-item">
            <a class="nav-link @(hiddenTab ? "" : "active")" href="@TabUrl("reported")" aria-current="@(hiddenTab ? null : "page")">@L["Reported"] <span class="badge text-bg-danger">@reportedCount</span></a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(hiddenTab ? "active" : "")" href="@TabUrl("hidden")" aria-current="@(hiddenTab ? "page" : null)">@L["Hidden"]</a>
        </li>
    </ul>

    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <i class="bi bi-shield-check"></i>
            <h2 class="h5 mt-3">@(hiddenTab ? L["No hidden comments"] : L["No reported comments"])</h2>
            <p class="mb-0">@(hiddenTab ? L["Comments you hide will appear here so you can show them again."] : L["When readers report a comment, it will appear here."])</p>
        </div>
    }

    <div class="d-flex flex-column gap-3">
        @foreach (var item in Model)
        {
            var c = item.Comment;
            <article class="moderation-item @(c.IsHidden ? "is-hidden" : "")">
                <div class="d-flex flex-wrap justify-content-between gap-2 mb-2">
                    <div class="small">
                        <strong>@item.CommenterName</strong>
                        <span class="text-muted">@L["on"]</span>
                        <a href="@(UiLanguage.WithLanguage(SeoUrls.ArticlePath(item.ArticleId, item.ArticleSlug), item.ArticleLanguage))#comment-@c.CommentId" lang="@item.ArticleLanguage">@item.ArticleTitle</a>
                        <span class="text-muted">&bull; <time datetime="@c.CreatedDate.ToString("yyyy-MM-ddTHH:mm")">@c.CreatedDate.ToString("d MMM yyyy, h:mm tt")</time></span>
                    </div>
                    <div class="d-flex flex-wrap gap-2">
                        @if (c.IsHidden)
                        {
                            <span class="badge text-bg-secondary align-self-center"><i class="bi bi-eye-slash" aria-hidden="true"></i> @(c.ModeratedById.HasValue ? L["Hidden by {0}", item.ModeratedByName ?? L["an admin"].Value] : L["Hidden automatically"])</span>
                        }
                        @if (item.Reports.Count > 0)
                        {
                            <span class="badge text-bg-danger align-self-center"><i class="bi bi-flag-fill" aria-hidden="true"></i> @L["{0} reports", item.Reports.Count]</span>
                        }
                    </div>
                </div>
                <blockquote class="moderation-text">@c.Text</blockquote>
                @if (item.Reports.Count > 0)
                {
                    <ul class="moderation-reports list-unstyled small mb-3">
                        @foreach (var r in item.Reports)
                        {
                            <li>
                                <span class="fw-semibold">@L[r.ReasonName]</span>
                                <span class="text-muted">&bull; @r.ReporterName &bull; @r.CreatedAt.ToString("d MMM, h:mm tt")</span>
                                @if (!string.IsNullOrEmpty(r.Note))
                                {
                                    <div class="text-muted">“@r.Note”</div>
                                }
                            </li>
                        }
                    </ul>
                }
                <div class="d-flex flex-wrap gap-2">
                    <form asp-action="KeepComment" method="post">
                        <input type="hidden" name="id" value="@c.CommentId" />
                        <input type="hidden" name="returnUrl" value="@Here()" />
                        <button type="submit" class="btn btn-sm btn-outline-success"><i class="bi bi-check2" aria-hidden="true"></i> @(c.IsHidden ? L["Show again"] : L["Keep comment"])</button>
                    </form>
                    @if (!c.IsHidden || item.Reports.Count > 0)
                    {
                        <form asp-action="HideComment" method="post">
                            <input type="hidden" name="id" value="@c.CommentId" />
                            <input type="hidden" name="returnUrl" value="@Here()" />
                            <button type="submit" class="btn btn-sm btn-outline-secondary"><i class="bi bi-eye-slash" aria-hidden="true"></i> @L["Hide"]</button>
                        </form>
                    }
                    <form asp-action="DeleteComment" method="post" data-confirm="@L["Delete this comment?"]">
                        <input type="hidden" name="id" value="@c.CommentId" />
                        <input type="hidden" name="returnUrl" value="@Here()" />
                        <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash" aria-hidden="true"></i> @L["Delete"]</button>
                    </form>
                </div>
            </article>
        }
    </div>

    @if (totalPages > 1)
    {
        <nav class="mt-4" aria-label="@L["Pages"]">
            <ul class="pagination justify-content-center flex-wrap">
                @for (var i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == page ? "active" : "")"><a class="page-link" href="@TabUrl(tab, i)" aria-current="@(i == page ? "page" : null)">@i</a></li>
                }
            </ul>
        </nav>
    }
</div>
