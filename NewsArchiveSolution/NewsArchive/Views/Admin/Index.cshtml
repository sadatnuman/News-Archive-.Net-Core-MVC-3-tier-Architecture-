@{
    ViewData["Title"] = L["Admin dashboard"];
    ViewData["NoIndex"] = true;
    var mostViewed = ViewBag.MostViewed as List<BLL.DTOs.ArticleDTO> ?? new List<BLL.DTOs.ArticleDTO>();
    var perCategory = ViewBag.ArticlesPerCategory as List<(string Category, int Count)> ?? new List<(string Category, int Count)>();
    var pending = (int)(ViewBag.PendingCount ?? 0);
    var reported = (int)(ViewBag.ReportedCount ?? 0);
    var maxCategory = perCategory.Count > 0 ? perCategory.Max(c => c.Count) : 1;
}

<div class="container py-4 py-lg-5">
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
        <h1 class="page-title mb-0">@L["Admin dashboard"]</h1>
        <div class="d-flex flex-wrap gap-2">
            <a asp-controller="Article" asp-action="Create" class="btn btn-primary"><i class="bi bi-pencil-square"></i> @L["Write"]</a>
            <a asp-controller="Category" asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-folder"></i> @L["Sections"]</a>
            <a asp-action="AllUser" class="btn btn-outline-secondary"><i class="bi bi-people"></i> @L["Users"]</a>
        </div>
    </div>

    <div class="row g-3 mb-5">
        <div class="col-6 col-lg-3">
            <div class="data-card">
                <div class="label">@L["Articles"]</div>
                <div class="value">@ViewBag.TotalArticles</div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="data-card">
                <div class="label">@L["Users"]</div>
                <div class="value">@ViewBag.TotalUsers</div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <a asp-action="PendingArticles" class="data-card d-block h-100 @(pending > 0 ? "border-warning" : "")">
                <div class="label">@L["Awaiting approval"]</div>
                <div class="value">@pending</div>
                <span class="small fw-semibold">@L["Review queue"] <i class="bi bi-arrow-right" aria-hidden="true"></i></span>
            </a>
        </div>
        <div class="col-6 col-lg-3">
            <a asp-action="Comments" class="data-card d-block h-100 @(reported > 0 ? "border-danger" : "")">
                <div class="label">@L["Reported comments"]</div>
                <div class="value">@reported</div>
                <span class="small fw-semibold">@L["Moderate comments"] <i class="bi bi-arrow-right" aria-hidden="true"></i></span>
            </a>
        </div>
    </div>

    <div class="row g-4 g-lg-5">
        <section class="col-lg-6" aria-labelledby="viewed-heading">
            <div class="section-head"><h2 id="viewed-heading">@L["Most viewed"]</h2></div>
            <ol class="rank-list">
                @foreach (var art in mostViewed)
                {
                    <li>
                        <div class="d-flex justify-content-between gap-3">
                            <a href="@SeoUrls.Article(art)" lang="@art.LanguageCode">@art.Title</a>
                            <span class="meta text-nowrap">@L["{0} views", art.ViewsCount]</span>
                        </div>
                    </li>
                }
            </ol>
        </section>
        <section class="col-lg-6" aria-labelledby="category-heading">
            <div class="section-head"><h2 id="category-heading">@L["Published articles per section"]</h2></div>
            @foreach (var cat in perCategory.OrderByDescending(c => c.Count))
            {
                <div class="mb-3">
                    <div class="d-flex justify-content-between small mb-1">
                        <span class="fw-semibold">@cat.Category</span>
                        <span class="text-muted">@cat.Count</span>
                    </div>
                    <div class="progress" style="height: 8px;" role="progressbar" aria-label="@cat.Category" aria-valuenow="@cat.Count" aria-valuemin="0" aria-valuemax="@maxCategory">
                        <div class="progress-bar bg-dark" style="width: @(cat.Count * 100 / maxCategory)%"></div>
                    </div>
                </div>
            }
        </section>
    </div>
</div>
