@model List<BLL.DTOs.ArticleDTO>

@{
    ViewData["Title"] = L["Articles awaiting approval"];
    ViewData["NoIndex"] = true;
    var authors = ViewBag.AuthorNames as Dictionary<int, string> ?? new Dictionary<int, string>();
    var categories = ViewBag.CategoryNames as Dictionary<int, string> ?? new Dictionary<int, string>();
    var scheduled = ViewBag.Scheduled as List<BLL.DTOs.ArticleDTO> ?? new List<BLL.DTOs.ArticleDTO>();
    var minLocal = DateTime.Now.AddMinutes(2).ToString("yyyy-MM-ddTHH:mm");
}

<div class="container py-4 py-lg-5">
    <header class="mb-4">
        <h1 class="page-title">@L["Articles awaiting approval"]</h1>
        <p class="page-intro mb-0">@L["Nothing written by authors goes live until you approve it. Open an article to read it in full before deciding."]</p>
    </header>

    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <i class="bi bi-inbox"></i>
            <h2 class="h5 mt-3">@L["The review queue is empty"]</h2>
            <p class="mb-0">@L["New submissions from authors will appear here."]</p>
        </div>
    }
    else
    {
        @foreach (var a in Model)
        {
            <div class="data-card mb-3">
                <div class="d-flex flex-wrap justify-content-between gap-3">
                    <div class="flex-grow-1" style="min-width: 260px;">
                        <span class="kicker">@(categories.TryGetValue(a.CategoryId, out var c) ? c : L["Uncategorised"])</span>
                        <span class="badge text-bg-secondary ms-1">@AppLanguages.NativeName(a.LanguageCode)</span>
                        <h2 class="h5 mt-1 mb-1" lang="@a.LanguageCode"><a href="@SeoUrls.Article(a)">@a.Title</a></h2>
                        <p class="text-muted small mb-2" lang="@a.LanguageCode">@PageMeta.Shorten(a.Summary, 220)</p>
                        <div class="meta">
                            @L["By {0}", authors.TryGetValue(a.AuthorId, out var n) ? n : L["Unknown"]]
                            <span class="sep">&bull;</span>
                            @L["Submitted {0}", (a.UpdatedAt ?? a.CreatedAt).ToString("d MMM yyyy, h:mm tt")]
                        </div>
                    </div>
                    <div class="d-flex flex-column gap-2" style="min-width: 260px;">
                        <div class="d-flex gap-2">
                            <a href="@SeoUrls.Article(a)" class="btn btn-outline-secondary flex-grow-1"><i class="bi bi-eye"></i> @L["Read"]</a>
                        </div>
                        <form asp-action="Approve" asp-route-id="@a.ArticleId" method="post" class="d-flex flex-column gap-2">
                            <label class="small text-muted" for="publishAt-@a.ArticleId">@L["Publish at (leave empty to publish now)"]</label>
                            <div class="d-flex gap-2">
                                <input id="publishAt-@a.ArticleId" type="datetime-local" name="publishAt" class="form-control form-control-sm" min="@minLocal" />
                                <button type="submit" class="btn btn-success flex-shrink-0"><i class="bi bi-check2-circle"></i> @L["Approve"]</button>
                            </div>
                        </form>
                        <form asp-action="Reject" asp-route-id="@a.ArticleId" method="post" class="d-flex gap-2">
                            <input type="text" name="note" class="form-control form-control-sm" placeholder="@L["Reason for rejection"]" maxlength="500" required aria-label="@L["Reason for rejection"]" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">@L["Reject"]</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    }

    @if (scheduled.Count > 0)
    {
        <section class="mt-5" aria-labelledby="scheduled-heading">
            <div class="section-head">
                <h2 id="scheduled-heading">@L["Scheduled to publish"]</h2>
                <span class="meta">@scheduled.Count</span>
            </div>
            @foreach (var a in scheduled)
            {
                <div class="data-card mb-3">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                        <div class="flex-grow-1" style="min-width: 260px;">
                            <span class="status-pill s-@a.StatusId">@L[a.StatusName]</span>
                            <h3 class="h6 mt-2 mb-1" lang="@a.LanguageCode"><a href="@SeoUrls.Article(a)">@a.Title</a></h3>
                            <div class="meta">
                                <i class="bi bi-clock" aria-hidden="true"></i>
                                @L["Goes live {0}", a.ScheduledAt?.ToString("d MMM yyyy, h:mm tt") ?? ""]
                                <span class="sep">&bull;</span>
                                @L["By {0}", authors.TryGetValue(a.AuthorId, out var sn) ? sn : L["Unknown"]]
                            </div>
                        </div>
                        <div class="d-flex gap-2">
                            <form asp-action="PublishNow" asp-route-id="@a.ArticleId" method="post">
                                <button type="submit" class="btn btn-sm btn-success"><i class="bi bi-lightning-charge"></i> @L["Publish now"]</button>
                            </form>
                            <form asp-action="Unschedule" asp-route-id="@a.ArticleId" method="post">
                                <button type="submit" class="btn btn-sm btn-outline-secondary">@L["Back to review"]</button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </section>
    }
</div>
