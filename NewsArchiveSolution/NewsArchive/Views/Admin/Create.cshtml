@model BLL.DTOs.UserDTO

@{
    ViewData["Title"] = L["Add user"];
    ViewData["NoIndex"] = true;
    var roles = ViewBag.Roles as IEnumerable<BLL.DTOs.RoleDTO> ?? Enumerable.Empty<BLL.DTOs.RoleDTO>();
}

<div class="container">
    <div class="auth-card">
        <h1 class="h3 mb-4">@L["Add user"]</h1>
        <form asp-action="Create" method="post">
            <input type="hidden" asp-for="CreatedAt" value="@DateTime.Now.ToString("s")" />
            <partial name="_UserFields" model="Model" />
            <div class="mb-4">
                <label asp-for="RoleId" class="form-label fw-semibold"></label>
                <select asp-for="RoleId" class="form-select">
                    <option value="">@L["Select a role"]</option>
                    @foreach (var r in roles)
                    {
                        <option value="@r.Id">@L[r.RoleName]</option>
                    }
                </select>
                <span asp-validation-for="RoleId" class="text-danger small"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">@L["Add user"]</button>
                <a asp-action="AllUser" class="btn btn-link">@L["Cancel"]</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
