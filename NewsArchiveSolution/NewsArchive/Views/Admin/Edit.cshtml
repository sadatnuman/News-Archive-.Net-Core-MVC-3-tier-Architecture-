@model BLL.DTOs.UserDTO
@{
    ViewBag.Title = "Edit User";
    var roles = ViewBag.Roles as IEnumerable<BLL.DTOs.RoleDTO>;
}

<h2>Edit User</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="UserId" />

    <div class="form-group">
        <label asp-for="Name"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Email"></label>
        <input asp-for="Email" class="form-control" readonly />
    </div>

    <div class="form-group">
        <label asp-for="RoleId">Role</label>
        <select asp-for="RoleId" class="form-control" asp-items="@(new SelectList(roles, "Id", "RoleName", Model.RoleId))"></select>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="AllUser" class="btn btn-secondary">Cancel</a>
</form>