@model BLL.DTOs.UserDTO

@{
    ViewData["Title"] = L["Edit user"];
    ViewData["NoIndex"] = true;
    var roles = ViewBag.Roles as IEnumerable<BLL.DTOs.RoleDTO> ?? Enumerable.Empty<BLL.DTOs.RoleDTO>();
}

<div class="container">
    <div class="auth-card">
        <h1 class="h3 mb-4">@L["Edit user"]</h1>
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="UserId" />
            <div class="mb-3">
                <label asp-for="Name" class="form-label fw-semibold"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label fw-semibold"></label>
                <input asp-for="Email" class="form-control" readonly />
            </div>
            <div class="mb-4">
                <label asp-for="RoleId" class="form-label fw-semibold"></label>
                <select asp-for="RoleId" class="form-select">
                    @foreach (var r in roles)
                    {
                        <option value="@r.Id">@L[r.RoleName]</option>
                    }
                </select>
                <div class="form-text">@L["Give a user the Author role so they can write articles for review."]</div>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">@L["Save changes"]</button>
                <a asp-action="AllUser" class="btn btn-link">@L["Cancel"]</a>
            </div>
        </form>
    </div>
</div>
