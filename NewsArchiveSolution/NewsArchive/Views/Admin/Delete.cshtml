@model BLL.DTOs.UserDTO

@{
    ViewData["Title"] = L["Delete user"];
    ViewData["NoIndex"] = true;
}

<div class="container">
    <div class="auth-card">
        <h1 class="h3 mb-3">@L["Delete this user?"]</h1>
        <dl class="row mb-4">
            <dt class="col-4">@L["Name"]</dt>
            <dd class="col-8">@Model.Name</dd>
            <dt class="col-4">@L["Email"]</dt>
            <dd class="col-8">@Model.Email</dd>
            <dt class="col-4">@L["Role"]</dt>
            <dd class="col-8">@L[AppRoles.Name(Model.RoleId)]</dd>
        </dl>
        <p class="small text-muted">@L["Their comments are deleted too. Users who have written articles cannot be deleted."]</p>
        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="UserId" />
            <input type="hidden" name="id" value="@Model.UserId" />
            <div class="d-flex gap-2">
                <button type="submit" name="Decision" value="Yes" class="btn btn-danger">@L["Yes, delete"]</button>
                <a asp-action="AllUser" class="btn btn-outline-secondary">@L["Cancel"]</a>
            </div>
        </form>
    </div>
</div>
