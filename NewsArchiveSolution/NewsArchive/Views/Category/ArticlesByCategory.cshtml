@model List<BLL.DTOs.ArticleDTO>

@{
    ViewData["Title"] = ViewBag.Category?.Name + " - Articles";
    var category = ViewBag.Category as BLL.DTOs.CategoryDTO;
    var roleId = Context.Session.GetInt32("RoleId");
    var isAdmin = roleId == 1;
}

<div class="container py-5">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Article")">Home</a></li>
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Category")">Categories</a></li>
            <li class="breadcrumb-item active">@category?.Name</li>
        </ol>
    </nav>

    <div class="mb-5">
        <h1 class="display-4 fw-bold mb-2">@category?.Name</h1>
        @if (!string.IsNullOrEmpty(category?.Description))
        {
            <p class="lead text-muted">@category.Description</p>
        }
        <p class="text-muted">
            <i class="bi bi-newspaper"></i>
            @(Model?.Count ?? 0) article(s) in this category
        </p>
    </div>

    @if (Model != null && Model.Count > 0)
    {
        <div class="row g-4">
            @foreach (var article in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm hover-shadow transition">
                        @{
                            string imgUrl = null;
                            var imagePath = article.ImagePath;
                            if (!string.IsNullOrEmpty(imagePath))
                            {
                                if (imagePath.StartsWith("~") || imagePath.StartsWith("http"))
                                {
                                    imgUrl = Url.Content(imagePath);
                                }
                                else if (imagePath.StartsWith("/"))
                                {
                                    imgUrl = imagePath;
                                }
                                else
                                {
                                    imgUrl = "/" + imagePath;
                                }
                            }
                        }

                        @if (!string.IsNullOrEmpty(imgUrl))
                        {
                            <img src="@imgUrl" class="card-img-top" alt="@article.Title" style="height: 250px; object-fit: cover;">
                        }
                        else
                        {
                            <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 250px;">
                                <i class="bi bi-image" style="font-size: 3rem; color: #ccc;"></i>
                            </div>
                        }

                        <div class="card-body d-flex flex-column">
                            <div class="mb-2">
                                <span class="badge bg-info text-dark">@category?.Name</span>
                            </div>

                            <h5 class="card-title fw-bold">@article.Title</h5>

                            <p class="card-text text-muted small flex-grow-1">
                                @article.Summary
                            </p>

                            <div class="text-muted small mb-3">
                                <i class="bi bi-calendar"></i> 
                                <span>@article.PublishDate.ToString("MMM dd, yyyy")</span>
                            </div>

                            <a href="@Url.Action("Details", "Article", new { id = article.ArticleId })" class="btn btn-sm btn-outline-primary">
                                Read More →
                            </a>
                        </div>

                        @if (isAdmin)
                        {
                            <div class="card-footer bg-white border-top">
                                <div class="btn-group btn-group-sm w-100" role="group">
                                    <a href="@Url.Action("Edit", "Article", new { id = article.ArticleId })" class="btn btn-outline-warning">
                                        <i class="bi bi-pencil"></i> Edit
                                    </a>
                                    <a href="@Url.Action("Delete", "Article", new { id = article.ArticleId })" class="btn btn-outline-danger">
                                        <i class="bi bi-trash"></i> Delete
                                    </a>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info text-center py-5">
            <h5>No articles in this category yet</h5>
            <p class="mb-0">
                <a href="@Url.Action("Index", "Article")">Browse all articles →</a>
            </p>
        </div>
    }
</div>

<style>
    .hover-shadow {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    
    .hover-shadow:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 30px rgba(0,0,0,0.15) !important;
    }
</style>
