@model List<BLL.DTOs.ArticleDTO>
@using NewsArchive.Seo
@inject SeoUrls Urls

@{
    var category = ViewBag.Category as BLL.DTOs.CategoryDTO;
    var name = category?.Name ?? "News";
    var path = SeoUrls.Category(category?.CategoryId ?? 0, category?.Slug);

    var meta = ViewData.Meta();
    meta.Title = $"{name} news";
    meta.Description = string.IsNullOrWhiteSpace(category?.Description)
        ? $"The latest {name} news, analysis and reporting from NewsArchive."
        : category!.Description;
    meta.CanonicalPath = path;
    meta.Image = Model.FirstOrDefault(a => !string.IsNullOrEmpty(a.ImagePath))?.ImagePath;
    meta.Breadcrumbs.Add((name, path));
    meta.JsonLd.Add(new Dictionary<string, object?>
    {
        ["@type"] = "CollectionPage",
        ["name"] = $"{name} news",
        ["url"] = Urls.Absolute(path),
        ["description"] = meta.Description,
        ["mainEntity"] = new Dictionary<string, object?>
        {
            ["@type"] = "ItemList",
            ["itemListElement"] = Model.Select((a, i) => new Dictionary<string, object?>
            {
                ["@type"] = "ListItem",
                ["position"] = i + 1,
                ["url"] = Urls.Absolute(SeoUrls.Article(a.ArticleId, a.Slug))
            }).ToList()
        }
    });

    var lead = Model.FirstOrDefault();
}

<div class="container py-4 py-lg-5">
    <nav class="crumbs" aria-label="Breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Home</a></li>
            <li class="breadcrumb-item"><a href="/Category">Sections</a></li>
            <li class="breadcrumb-item active" aria-current="page">@name</li>
        </ol>
    </nav>

    <header class="mb-4 pb-3 border-bottom">
        <span class="kicker">Section</span>
        <h1 class="page-title mt-1">@name news</h1>
        @if (!string.IsNullOrWhiteSpace(category?.Description))
        {
            <p class="page-intro mb-0">@category.Description</p>
        }
    </header>

    @if (lead == null)
    {
        <div class="empty-state">
            <i class="bi bi-folder2-open"></i>
            <h2 class="h5 mt-3">No @name stories yet</h2>
            <p class="mb-0"><a href="/">Read the latest news</a></p>
        </div>
    }
    else
    {
        <section class="mb-5" aria-label="Top @name story">
            <partial name="_StoryLead" model="lead" />
        </section>

        @if (Model.Count > 1)
        {
            <section aria-labelledby="more-heading">
                <div class="section-head">
                    <h2 id="more-heading">More @name stories</h2>
                </div>
                <div class="row g-4">
                    @foreach (var item in Model.Skip(1))
                    {
                        <div class="col-md-6 col-lg-4">
                            <partial name="_StoryCard" model="item" />
                        </div>
                    }
                </div>
            </section>
        }
    }
</div>
