@model IEnumerable<BLL.DTOs.CategoryDTO>
@using BLL
@using NewsArchive.Seo

@{
    var isAdmin = Context.Session.GetInt32("RoleId") == AppRoles.Admin;
    var meta = ViewData.Meta();
    meta.Title = "News sections";
    meta.Description = "Browse NewsArchive coverage by section: " + string.Join(", ", Model.Select(c => c.Name)) + ".";
    meta.CanonicalPath = "/Category";
    meta.Breadcrumbs.Add(("Sections", "/Category"));
}

<div class="container py-4 py-lg-5">
    <nav class="crumbs" aria-label="Breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Home</a></li>
            <li class="breadcrumb-item active" aria-current="page">Sections</li>
        </ol>
    </nav>

    <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
        <header>
            <h1 class="page-title">News sections</h1>
            <p class="page-intro mb-0">Every story in the archive is filed under one of these sections.</p>
        </header>
        @if (isAdmin)
        {
            <a asp-action="Create" class="btn btn-primary"><i class="bi bi-folder-plus"></i> New section</a>
        }
    </div>

    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="data-card d-flex flex-column">
                    <h2 class="h4 mb-2"><a href="@SeoUrls.Category(item.CategoryId, item.Slug)">@item.Name</a></h2>
                    <p class="text-muted small flex-grow-1">@item.Description</p>
                    <div class="d-flex align-items-center gap-2">
                        <a href="@SeoUrls.Category(item.CategoryId, item.Slug)" class="btn btn-outline-primary btn-sm">Read @item.Name news</a>
                        @if (isAdmin)
                        {
                            <a asp-action="Edit" asp-route-id="@item.CategoryId" class="btn btn-sm btn-link">Edit</a>
                            <a asp-action="Delete" asp-route-id="@item.CategoryId" class="btn btn-sm btn-link text-danger">Delete</a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>
