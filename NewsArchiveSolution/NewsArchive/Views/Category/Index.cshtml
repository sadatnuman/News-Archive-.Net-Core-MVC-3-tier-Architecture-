@model IEnumerable<BLL.DTOs.CategoryDTO>

@{
    var lang = UiLanguage.Current;
    var isAdmin = User.RoleId() == AppRoles.Admin;
    var counts = ViewBag.ArticleCounts as Dictionary<int, int> ?? new Dictionary<int, int>();
    var meta = ViewData.Meta();
    meta.Title = L["News sections"];
    meta.Description = L["Browse The Meridian Newsfolio coverage by section: {0}.", string.Join(", ", Model.Select(c => c.LocalName(lang)))];
    meta.CanonicalPath = SeoUrls.Page("/Category");
    meta.Breadcrumbs.Add((L["Sections"], SeoUrls.Page("/Category")));
}

<div class="container py-4 py-lg-5">
    <nav class="crumbs" aria-label="@L["Breadcrumb"]">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="@SeoUrls.Page("/")">@L["Home"]</a></li>
            <li class="breadcrumb-item active" aria-current="page">@L["Sections"]</li>
        </ol>
    </nav>

    <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
        <header>
            <h1 class="page-title">@L["News sections"]</h1>
            <p class="page-intro mb-0">@L["Every story in the archive is filed under one of these sections."]</p>
        </header>
        @if (isAdmin)
        {
            <a asp-action="Create" class="btn btn-primary"><i class="bi bi-folder-plus"></i> @L["New section"]</a>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <i class="bi bi-folder2-open"></i>
            <h2 class="h5 mt-3">@L["No sections yet"]</h2>
        </div>
    }

    <div class="row g-4">
        @foreach (var item in Model)
        {
            var url = SeoUrls.Category(item.CategoryId, item.Slug);
            <div class="col-md-6 col-lg-4">
                <div class="data-card d-flex flex-column" data-tilt data-tilt-max="5">
                    <h2 class="h4 mb-2"><a href="@url">@item.LocalName(lang)</a></h2>
                    <p class="text-muted small flex-grow-1">@item.LocalDescription(lang)</p>
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <a href="@url" class="btn btn-outline-primary btn-sm">@L["Read {0} news", item.LocalName(lang)]</a>
                        @if (isAdmin)
                        {
                            <span class="meta ms-auto">@L["{0} articles", counts.TryGetValue(item.CategoryId, out var n) ? n : 0]</span>
                            <a asp-action="Edit" asp-route-id="@item.CategoryId" class="btn btn-sm btn-link">@L["Edit"]</a>
                            <a asp-action="Delete" asp-route-id="@item.CategoryId" class="btn btn-sm btn-link text-danger">@L["Delete"]</a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>
