@model BLL.DTOs.CategoryDTO

@{
    var isEdit = Model.CategoryId > 0;
}

<form asp-action="@(isEdit ? "Edit" : "Create")" method="post" class="editor-form">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    <input type="hidden" asp-for="CategoryId" />

    <div class="row g-4">
        <div class="col-md-6">
            <h2 class="h6 text-uppercase text-muted mb-3">English</h2>
            <div class="mb-3">
                <label asp-for="Name" class="form-label fw-semibold"></label>
                <input asp-for="Name" class="form-control" maxlength="100" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Description" class="form-label fw-semibold"></label>
                <textarea asp-for="Description" class="form-control" rows="4" maxlength="255"></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>
        </div>
        <div class="col-md-6">
            <h2 class="h6 text-uppercase text-muted mb-3">বাংলা</h2>
            <div class="mb-3">
                <label asp-for="NameBn" class="form-label fw-semibold"></label>
                <input asp-for="NameBn" class="form-control" lang="bn" maxlength="100" />
                <span asp-validation-for="NameBn" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DescriptionBn" class="form-label fw-semibold"></label>
                <textarea asp-for="DescriptionBn" class="form-control" lang="bn" rows="4" maxlength="255"></textarea>
                <span asp-validation-for="DescriptionBn" class="text-danger small"></span>
            </div>
        </div>
    </div>

    <p class="small text-muted">@L["If the Bangla name is empty, the English name is shown on the Bangla site."]</p>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">@L[isEdit ? "Save changes" : "Create section"]</button>
        <a asp-action="Index" class="btn btn-link">@L["Cancel"]</a>
    </div>
</form>
