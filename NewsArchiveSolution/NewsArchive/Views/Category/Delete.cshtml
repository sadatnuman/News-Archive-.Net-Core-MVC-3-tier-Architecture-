@model BLL.DTOs.CategoryDTO

@{
    ViewData["Title"] = L["Delete section"];
    ViewData["NoIndex"] = true;
    var count = (int)(ViewBag.ArticleCount ?? 0);
    var others = ViewBag.OtherCategories as List<BLL.DTOs.CategoryDTO> ?? new List<BLL.DTOs.CategoryDTO>();
}

<div class="container py-5">
    <div class="auth-card" style="max-width: 560px;">
        <h1 class="h3 mb-3">@L["Delete section"]</h1>
        <p class="fw-semibold mb-1">@Model.LocalName(UiLanguage.Current)</p>
        <p class="text-muted small">@Model.LocalDescription(UiLanguage.Current)</p>

        <form asp-action="Delete" method="post">
            <input type="hidden" name="id" value="@Model.CategoryId" />

            @if (count > 0)
            {
                <div class="alert alert-warning">
                    @L["This section has {0} articles. Choose where to move them before deleting.", count]
                </div>
                <div class="mb-3">
                    <label for="moveArticlesTo" class="form-label fw-semibold">@L["Move articles to"]</label>
                    <select id="moveArticlesTo" name="moveArticlesTo" class="form-select" required>
                        <option value="">@L["Select a section"]</option>
                        @foreach (var c in others)
                        {
                            <option value="@c.CategoryId">@c.LocalName(UiLanguage.Current)</option>
                        }
                    </select>
                </div>
            }

            <div class="d-flex gap-2">
                <button type="submit" name="Decision" value="Yes" class="btn btn-danger" disabled="@(count > 0 && others.Count == 0 ? "disabled" : null)">@L["Yes, delete"]</button>
                <a asp-action="Index" class="btn btn-outline-secondary">@L["Cancel"]</a>
            </div>
        </form>
    </div>
</div>
