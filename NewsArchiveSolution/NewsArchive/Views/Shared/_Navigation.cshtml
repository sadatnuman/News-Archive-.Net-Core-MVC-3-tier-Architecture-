@using BLL.Services
@using Microsoft.Extensions.Options
@inject CategoryService categoryService
@inject ArticleService articleService
@inject IOptions<SiteOptions> SiteConfig

@{
    var site = SiteConfig.Value;
    var lang = UiLanguage.Current;
    var roleId = User.RoleId();
    var isLoggedIn = User.IsSignedIn() && roleId.HasValue;
    var isAdmin = roleId == AppRoles.Admin;
    var isAuthor = roleId == AppRoles.Author;
    var categories = categoryService.Get();
    var primary = categories.Take(6).ToList();
    var more = categories.Skip(6).ToList();
    var breaking = articleService.GetBreakingNews(lang).Take(6).ToList();
    var pendingCount = isAdmin ? articleService.CountPending() : 0;
    var path = Context.Request.Path.Value ?? "/";
    string Active(string prefix) => path.Equals(prefix, StringComparison.OrdinalIgnoreCase) || (prefix != "/" && path.StartsWith(prefix, StringComparison.OrdinalIgnoreCase)) ? "active" : "";
    string RoleName(int? id) => id == AppRoles.Admin ? L["Admin"] : id == AppRoles.Author ? L["Author"] : L["Reader"];
}

<div class="topbar">
    <div class="container d-flex flex-wrap justify-content-between align-items-center gap-2 py-2">
        <time datetime="@DateTime.Now.ToString("yyyy-MM-dd")">@DateTime.Now.ToString("dddd, d MMMM yyyy")</time>
        <div class="d-flex flex-wrap align-items-center gap-3">
            <nav class="lang-switch" aria-label="@L["Language"]">
                @foreach (var code in AppLanguages.All)
                {
                    <a href="@UiLanguage.SwitchUrl(Context.Request, code)" hreflang="@code" lang="@code" class="@(code == lang ? "active" : "")" aria-current="@(code == lang ? "true" : null)">@AppLanguages.NativeName(code)</a>
                }
            </nav>
            <div class="btn-group theme-switch" role="group" aria-label="@L["Theme"]">
                <button type="button" class="btn" data-theme-value="light" title="@L["Light"]" aria-label="@L["Light"]"><i class="bi bi-sun"></i></button>
                <button type="button" class="btn" data-theme-value="dark" title="@L["Dark"]" aria-label="@L["Dark"]"><i class="bi bi-moon-stars"></i></button>
                <button type="button" class="btn" data-theme-value="system" title="@L["System"]" aria-label="@L["System"]"><i class="bi bi-circle-half"></i></button>
            </div>
            <div class="d-flex align-items-center">
                @if (!isLoggedIn)
                {
                    <a asp-controller="Auth" asp-action="Login" rel="nofollow">@L["Sign in"]</a>
                    <span class="divider">|</span>
                    <a asp-controller="Auth" asp-action="Create" rel="nofollow">@L["Create account"]</a>
                }
                else
                {
                    <span class="d-inline-flex align-items-center gap-2">
                        @await Html.PartialAsync("_Avatar", (User.DisplayName() ?? string.Empty, User.AvatarPath(), "avatar-xs"))
                        <span class="d-none d-sm-inline">@L["Signed in as {0}", RoleName(roleId)]</span>
                    </span>
                    <span class="divider d-none d-sm-inline">|</span>
                    <a asp-controller="Auth" asp-action="Logout" rel="nofollow">@L["Sign out"]</a>
                }
            </div>
        </div>
    </div>
</div>

<header class="masthead">
    <div class="container d-flex flex-column flex-md-row align-items-center justify-content-between gap-3 py-3">
        <a class="brand" href="@SeoUrls.Page("/")" aria-label="@L["{0} home", site.Name]">
            <img class="brand-logo" src="~/images/brand/logo-mark.svg" width="60" height="51" alt="" />
            <span class="brand-text">
                <span class="brand-the">THE</span>
                <span class="brand-name">MERIDIAN</span>
                <span class="brand-sub">NEWSFOLIO</span>
                <span class="brand-tagline d-none d-md-block">@L[site.Tagline]</span>
            </span>
        </a>
        <form class="header-search" action="/search" method="get" role="search">
            @if (lang != AppLanguages.English)
            {
                <input type="hidden" name="lang" value="@lang" />
            }
            <label for="site-search" class="visually-hidden">@L["Search news"]</label>
            <i class="bi bi-search" aria-hidden="true"></i>
            <input id="site-search" type="search" name="keyword" class="form-control" placeholder="@L["Search news, topics, people"]" />
        </form>
    </div>
</header>

<nav class="sitenav navbar navbar-expand-lg py-0" aria-label="@L["Main"]">
    <div class="container">
        <button class="navbar-toggler my-2" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="@L["Toggle navigation"]">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="mainNav">
            <ul class="navbar-nav me-auto">
                <li class="nav-item"><a class="nav-link @Active("/")" href="@SeoUrls.Page("/")">@L["Home"]</a></li>
                <li class="nav-item"><a class="nav-link @Active("/trending")" href="@SeoUrls.Page("/trending")">@L["Trending"]</a></li>
                @if (breaking.Count > 0)
                {
                    <li class="nav-item"><a class="nav-link @Active("/breaking-news")" href="@SeoUrls.Page("/breaking-news")">@L["Breaking"]</a></li>
                }
                @foreach (var c in primary)
                {
                    <li class="nav-item"><a class="nav-link @Active($"/category/{c.CategoryId}/")" href="@SeoUrls.Category(c.CategoryId, c.Slug)">@c.LocalName(lang)</a></li>
                }
                @if (more.Count > 0)
                {
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="@SeoUrls.Page("/Category")" role="button" data-bs-toggle="dropdown" aria-expanded="false">@L["More"]</a>
                        <ul class="dropdown-menu">
                            @foreach (var c in more)
                            {
                                <li><a class="dropdown-item" href="@SeoUrls.Category(c.CategoryId, c.Slug)">@c.LocalName(lang)</a></li>
                            }
                            <li><hr class="dropdown-divider" /></li>
                            <li><a class="dropdown-item" href="@SeoUrls.Page("/Category")">@L["All sections"]</a></li>
                            <li><a class="dropdown-item" href="@SeoUrls.Page("/tags")">@L["All topics"]</a></li>
                        </ul>
                    </li>
                }
            </ul>

            @if (isLoggedIn)
            {
                <ul class="navbar-nav">
                    @if (isAdmin || isAuthor)
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Article" asp-action="Create"><i class="bi bi-pencil-square"></i> @L["Write"]</a>
                        </li>
                    }
                    @if (isAdmin)
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Admin" asp-action="PendingArticles">
                                <i class="bi bi-inbox"></i> @L["Review"]
                                @if (pendingCount > 0)
                                {
                                    <span class="badge rounded-pill text-bg-danger nav-badge">@pendingCount</span>
                                }
                            </a>
                        </li>
                    }
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-person-circle"></i> @L["Account"]
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            @if (isAdmin)
                            {
                                <li><a class="dropdown-item" asp-controller="Admin" asp-action="Index"><i class="bi bi-speedometer2 me-2"></i>@L["Dashboard"]</a></li>
                                <li><a class="dropdown-item" asp-controller="Admin" asp-action="PendingArticles"><i class="bi bi-inbox me-2"></i>@L["Pending articles"]</a></li>
                                <li><a class="dropdown-item" asp-controller="Admin" asp-action="AllUser"><i class="bi bi-people me-2"></i>@L["Users"]</a></li>
                                <li><a class="dropdown-item" asp-controller="Category" asp-action="Index"><i class="bi bi-folder me-2"></i>@L["Sections"]</a></li>
                                <li><a class="dropdown-item" href="@SeoUrls.Page("/tags")"><i class="bi bi-tags me-2"></i>@L["Tags"]</a></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li><a class="dropdown-item" asp-controller="Admin" asp-action="Profile"><i class="bi bi-person me-2"></i>@L["Profile"]</a></li>
                            }
                            else
                            {
                                @if (isAuthor)
                                {
                                    <li><a class="dropdown-item" asp-controller="Article" asp-action="MyArticles"><i class="bi bi-journal-text me-2"></i>@L["My articles"]</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                }
                                <li><a class="dropdown-item" asp-controller="Member" asp-action="Profile"><i class="bi bi-person me-2"></i>@L["Profile"]</a></li>
                            }
                            <li><a class="dropdown-item" asp-controller="Auth" asp-action="Logout"><i class="bi bi-box-arrow-right me-2"></i>@L["Sign out"]</a></li>
                        </ul>
                    </li>
                </ul>
            }
        </div>
    </div>
</nav>

@if (breaking.Count > 0)
{
    <div class="ticker" aria-label="@L["Breaking news"]">
        <div class="container d-flex align-items-stretch px-0 px-sm-2">
            <span class="ticker-label"><i class="bi bi-lightning-charge-fill"></i> @L["Breaking"]</span>
            <div class="overflow-hidden d-flex align-items-center flex-grow-1">
                <div class="ticker-track">
                    @foreach (var item in breaking.Concat(breaking))
                    {
                        <a href="@SeoUrls.Article(item)" lang="@item.LanguageCode">@item.Title</a>
                    }
                </div>
            </div>
        </div>
    </div>
}
