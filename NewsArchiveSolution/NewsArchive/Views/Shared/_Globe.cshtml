@model string

<div class="globe @Model" aria-hidden="true">
    <div class="globe-glow"></div>
    <div class="globe-sphere">
        <span class="globe-ring meridian m0"></span>
        <span class="globe-ring meridian m1"></span>
        <span class="globe-ring meridian m2"></span>
        <span class="globe-ring meridian m3"></span>
        <span class="globe-ring meridian m4"></span>
        <span class="globe-ring meridian m5"></span>
        <span class="globe-ring parallel p0"></span>
        <span class="globe-ring parallel p1"></span>
        <span class="globe-ring parallel p2"></span>
    </div>
    <div class="globe-orbit"><span class="globe-satellite"></span></div>
</div>
