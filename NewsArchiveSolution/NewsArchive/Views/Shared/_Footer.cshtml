@using BLL.Services
@using Microsoft.Extensions.Options
@using NewsArchive.Seo
@inject CategoryService categoryService
@inject IOptions<SiteOptions> SiteConfig

@{
    var site = SiteConfig.Value;
    var categories = categoryService.Get();
}

<footer class="site-footer" role="contentinfo">
    <div class="container py-5">
        <div class="row g-4">
            <div class="col-lg-4">
                <a class="brand mb-3" href="/" aria-label="@site.Name home">
                    <span class="brand-mark" aria-hidden="true">N</span>
                    <span>
                        <span class="brand-name">@site.Name</span>
                        <span class="brand-tagline">Independent news</span>
                    </span>
                </a>
                <p class="mt-3 mb-4">@site.Description</p>
                <div class="footer-social">
                    @foreach (var profile in site.SocialProfiles)
                    {
                        var icon = profile.Contains("linkedin") ? "linkedin" : profile.Contains("x.com") || profile.Contains("twitter") ? "twitter-x" : profile.Contains("facebook") ? "facebook" : profile.Contains("youtube") ? "youtube" : profile.Contains("instagram") ? "instagram" : "globe";
                        <a href="@profile" rel="noopener me" target="_blank" aria-label="@icon"><i class="bi bi-@icon"></i></a>
                    }
                    <a href="/rss.xml" aria-label="RSS feed"><i class="bi bi-rss"></i></a>
                </div>
            </div>

            <div class="col-6 col-md-4 col-lg-3">
                <h2>Sections</h2>
                <ul>
                    @foreach (var c in categories)
                    {
                        <li><a href="@SeoUrls.Category(c.CategoryId, c.Slug)">@c.Name</a></li>
                    }
                </ul>
            </div>

            <div class="col-6 col-md-4 col-lg-2">
                <h2>Explore</h2>
                <ul>
                    <li><a href="/">Latest news</a></li>
                    <li><a href="/trending">Trending</a></li>
                    <li><a href="/breaking-news">Breaking news</a></li>
                    <li><a href="/search">Search the archive</a></li>
                    <li><a href="/Category">All sections</a></li>
                    <li><a href="/rss.xml">RSS feed</a></li>
                    <li><a href="/sitemap.xml">Sitemap</a></li>
                </ul>
            </div>

            <div class="col-md-4 col-lg-3">
                <h2>Company</h2>
                <ul>
                    <li><a href="/about">About us</a></li>
                    <li><a href="/contact">Contact</a></li>
                    <li><a href="/editorial-policy">Editorial policy</a></li>
                    <li><a href="/privacy">Privacy policy</a></li>
                    <li><a href="/terms">Terms of use</a></li>
                </ul>
            </div>
        </div>
    </div>
    <div class="footer-bottom">
        <div class="container d-flex flex-column flex-md-row justify-content-between gap-2 py-3">
            <span>&copy; @DateTime.Now.Year @site.Name. All rights reserved.</span>
            <span>@site.Tagline.</span>
        </div>
    </div>
</footer>
