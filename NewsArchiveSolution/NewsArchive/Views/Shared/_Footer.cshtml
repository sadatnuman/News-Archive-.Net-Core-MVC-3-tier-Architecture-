@using BLL.Services
@using Microsoft.Extensions.Options
@inject CategoryService categoryService
@inject IOptions<SiteOptions> SiteConfig

@{
    var site = SiteConfig.Value;
    var lang = UiLanguage.Current;
    var categories = categoryService.Get();
}

<footer class="site-footer" role="contentinfo">
    <div class="container py-5">
        <div class="row g-4">
            <div class="col-lg-4">
                <a class="brand mb-3" href="@SeoUrls.Page("/")" aria-label="@L["{0} home", site.Name]">
                    <img class="brand-logo" src="~/images/brand/logo-mark.svg" width="52" height="44" alt="" />
                    <span class="brand-text">
                        <span class="brand-the">THE</span>
                        <span class="brand-name">MERIDIAN</span>
                        <span class="brand-sub">NEWSFOLIO</span>
                    </span>
                </a>
                <p class="mt-3 mb-4">@L[site.Description]</p>
                <div class="footer-social">
                    @foreach (var profile in site.SocialProfiles)
                    {
                        var icon = profile.Contains("linkedin") ? "linkedin" : profile.Contains("x.com") || profile.Contains("twitter") ? "twitter-x" : profile.Contains("facebook") ? "facebook" : profile.Contains("youtube") ? "youtube" : profile.Contains("instagram") ? "instagram" : "globe";
                        <a href="@profile" rel="noopener me" target="_blank" aria-label="@icon"><i class="bi bi-@icon"></i></a>
                    }
                    <a href="@SeoUrls.Page("/rss.xml")" aria-label="@L["RSS feed"]"><i class="bi bi-rss"></i></a>
                </div>
            </div>

            <div class="col-6 col-md-4 col-lg-3">
                <h2>@L["Sections"]</h2>
                <ul>
                    @foreach (var c in categories)
                    {
                        <li><a href="@SeoUrls.Category(c.CategoryId, c.Slug)">@c.LocalName(lang)</a></li>
                    }
                </ul>
            </div>

            <div class="col-6 col-md-4 col-lg-2">
                <h2>@L["Explore"]</h2>
                <ul>
                    <li><a href="@SeoUrls.Page("/")">@L["Latest news"]</a></li>
                    <li><a href="@SeoUrls.Page("/trending")">@L["Trending"]</a></li>
                    <li><a href="@SeoUrls.Page("/breaking-news")">@L["Breaking news"]</a></li>
                    <li><a href="@SeoUrls.Page("/search")">@L["Search the archive"]</a></li>
                    <li><a href="@SeoUrls.Page("/Category")">@L["All sections"]</a></li>
                    <li><a href="@SeoUrls.Page("/tags")">@L["Topics"]</a></li>
                    <li><a href="@SeoUrls.Page("/rss.xml")">@L["RSS feed"]</a></li>
                    <li><a href="/sitemap.xml">@L["Sitemap"]</a></li>
                </ul>
            </div>

            <div class="col-md-4 col-lg-3">
                <h2>@L["Company"]</h2>
                <ul>
                    <li><a href="@SeoUrls.Page("/about")">@L["About us"]</a></li>
                    <li><a href="@SeoUrls.Page("/contact")">@L["Contact"]</a></li>
                    <li><a href="@SeoUrls.Page("/editorial-policy")">@L["Editorial policy"]</a></li>
                    <li><a href="@SeoUrls.Page("/privacy")">@L["Privacy policy"]</a></li>
                    <li><a href="@SeoUrls.Page("/terms")">@L["Terms of use"]</a></li>
                </ul>
            </div>
        </div>
    </div>
    <div class="footer-bottom">
        <div class="container d-flex flex-column flex-md-row justify-content-between gap-2 py-3">
            <span>&copy; @DateTime.Now.Year @site.Name. @L["All rights reserved."]</span>
            <span>@L[site.Tagline].</span>
        </div>
    </div>
</footer>
