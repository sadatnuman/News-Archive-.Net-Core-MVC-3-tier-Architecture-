@model BLL.DTOs.ChangePasswordDTO

@{
    ViewData["Title"] = L["Change password"];
    ViewData["NoIndex"] = true;
    var resetVerified = ViewBag.ResetVerified as bool? == true;
}

<div class="container">
    <div class="auth-card">
        <h1 class="h3 mb-1">@L["Change password"]</h1>
        <p class="text-muted mb-4">@Model.Email</p>
        <form asp-action="ChangePassword" method="post">
            <input asp-for="UserId" type="hidden" />
            <input asp-for="Email" type="hidden" />
            @if (resetVerified)
            {
                <p class="small text-success"><i class="bi bi-shield-check" aria-hidden="true"></i> @L["Your email code was confirmed. Choose a new password."]</p>
            }
            else
            {
                <div class="mb-3">
                    <label asp-for="CurrentPassword" class="form-label fw-semibold"></label>
                    <input asp-for="CurrentPassword" type="password" class="form-control" autocomplete="current-password" required />
                    <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                </div>
            }
            <div class="mb-3">
                <label asp-for="PasswordHash" class="form-label fw-semibold"></label>
                <input asp-for="PasswordHash" type="password" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="PasswordHash" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ConfPassword" class="form-label fw-semibold"></label>
                <input asp-for="ConfPassword" type="password" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfPassword" class="text-danger small"></span>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-primary">@L["Change password"]</button>
                <a asp-action="Profile" class="btn btn-link">@L["Back to profile"]</a>
            </div>
        </form>
    </div>
</div>
