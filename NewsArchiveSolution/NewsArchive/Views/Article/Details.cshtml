@model BLL.DTOs.ArticleDTO
@inject SeoUrls Urls

@{
    var lang = UiLanguage.Current;
    var roleId = ViewBag.RoleId as int?;
    var userId = ViewBag.UserId as int?;
    var isAdmin = roleId == AppRoles.Admin;
    var isLoggedIn = userId.HasValue;
    var canEdit = ViewBag.CanEdit as bool? == true;
    var category = ViewBag.Category as BLL.DTOs.CategoryDTO;
    var categoryName = category?.LocalName(lang) ?? L["News"].Value;
    var sectionForSchema = category?.LocalName(Model.LanguageCode) ?? categoryName;
    var categoryUrl = category != null ? SeoUrls.Category(category.CategoryId, category.Slug) : SeoUrls.Page("/");
    var authorName = ViewBag.AuthorName as string ?? L["Staff reporter"].Value;
    var comments = ViewBag.Comments as List<BLL.DTOs.CommentDTO> ?? new List<BLL.DTOs.CommentDTO>();
    var commentNames = ViewBag.CommentUserNames as Dictionary<int, string> ?? new Dictionary<int, string>();
    var recommendations = ViewBag.Recommendations as List<BLL.DTOs.ArticleDTO> ?? new List<BLL.DTOs.ArticleDTO>();
    var latest = ViewBag.Latest as List<BLL.DTOs.ArticleDTO> ?? new List<BLL.DTOs.ArticleDTO>();
    var avatars = ViewBag.Avatars as Dictionary<int, string> ?? new Dictionary<int, string>();
    string? AvatarOf(int id) => avatars.TryGetValue(id, out var a) ? a : null;

    var path = SeoUrls.Article(Model);
    var absoluteUrl = Urls.Absolute(path);
    var image = SeoUrls.Image(Model.ImagePath);
    var paragraphs = (Model.Content ?? string.Empty)
        .Replace("\r\n", "\n")
        .Split("\n\n", StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
    var wordCount = (Model.Content ?? string.Empty).Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries).Length;
    var readingMinutes = Math.Max(1, (int)Math.Round(wordCount / 220.0));
    var modified = Model.UpdatedAt.HasValue && Model.UpdatedAt > Model.PublishDate ? Model.UpdatedAt : null;
    string Iso(DateTime d) => d.ToUniversalTime().ToString("yyyy-MM-ddTHH:mm:ssZ");

    var meta = ViewData.Meta();
    meta.Title = Model.Title;
    meta.Description = Model.Summary;
    meta.CanonicalPath = path;
    meta.ContentLanguage = Model.LanguageCode;
    meta.Image = Model.ImagePath;
    meta.ImageAlt = Model.Title;
    meta.Type = "article";
    meta.PublishedTime = Model.PublishDate;
    meta.ModifiedTime = modified ?? Model.PublishDate;
    meta.Section = sectionForSchema;
    meta.Author = authorName;
    meta.NoIndex = !Model.IsPublished;
    meta.Breadcrumbs.Add((categoryName, categoryUrl));
    meta.Breadcrumbs.Add((Model.Title, path));
    meta.JsonLd.Add(new Dictionary<string, object?>
    {
        ["@type"] = "NewsArticle",
        ["@id"] = absoluteUrl + "#article",
        ["mainEntityOfPage"] = absoluteUrl,
        ["headline"] = Model.Title.Length > 110 ? Model.Title[..110] : Model.Title,
        ["description"] = Model.Summary,
        ["image"] = new[] { Urls.AbsoluteImage(Model.ImagePath) },
        ["datePublished"] = Iso(Model.PublishDate),
        ["dateModified"] = Iso(modified ?? Model.PublishDate),
        ["author"] = new[] { new Dictionary<string, object?> { ["@type"] = "Person", ["name"] = authorName, ["url"] = Urls.Absolute(SeoUrls.AuthorPath(Model.AuthorId, authorName)) } },
        ["publisher"] = new Dictionary<string, object?> { ["@id"] = Urls.Absolute("/#organization") },
        ["articleSection"] = sectionForSchema,
        ["wordCount"] = wordCount,
        ["inLanguage"] = Model.LanguageCode,
        ["keywords"] = Model.Tags.Count > 0 ? string.Join(", ", Model.Tags.Select(t => t.LocalName(Model.LanguageCode))) : null,
        ["isAccessibleForFree"] = true
    });

    var shareUrl = Uri.EscapeDataString(absoluteUrl);
    var shareText = Uri.EscapeDataString(Model.Title);
    var statusLabel = L[Model.StatusName].Value;
}

<div class="container py-4 py-lg-5">
    <nav class="crumbs" aria-label="@L["Breadcrumb"]">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="@SeoUrls.Page("/")">@L["Home"]</a></li>
            <li class="breadcrumb-item"><a href="@categoryUrl">@categoryName</a></li>
            <li class="breadcrumb-item active text-truncate" aria-current="page" style="max-width: 32rem;" lang="@Model.LanguageCode">@Model.Title</li>
        </ol>
    </nav>

    @if (!Model.IsPublished)
    {
        var bannerClass = Model.StatusId == ArticleStatus.Pending ? "status-pending" : Model.StatusId == ArticleStatus.Rejected ? "status-rejected" : "status-draft";
        <div class="status-banner @bannerClass">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div>
                    <span class="status-pill s-@Model.StatusId">@statusLabel</span>
                    <span class="ms-2">@L["This article is not public. Only the author and admins can see it."]</span>
                    @if (!string.IsNullOrEmpty(Model.ReviewNote))
                    {
                        <div class="mt-2"><strong>@L["Editor's note:"]</strong> @Model.ReviewNote</div>
                    }
                </div>
                @if (isAdmin && Model.StatusId == ArticleStatus.Pending)
                {
                    <div class="d-flex flex-wrap gap-2">
                        <form asp-controller="Admin" asp-action="Approve" asp-route-id="@Model.ArticleId" method="post">
                            <button type="submit" class="btn btn-success"><i class="bi bi-check2-circle"></i> @L["Approve & publish"]</button>
                        </form>
                        <form asp-controller="Admin" asp-action="Reject" asp-route-id="@Model.ArticleId" method="post" class="d-flex gap-2">
                            <input type="text" name="note" class="form-control" placeholder="@L["Reason for rejection"]" maxlength="500" required aria-label="@L["Reason for rejection"]" />
                            <button type="submit" class="btn btn-outline-danger">@L["Reject"]</button>
                        </form>
                    </div>
                }
            </div>
        </div>
    }

    <div class="row g-4 g-lg-5">
        <article class="col-lg-8">
            <header class="article-header" lang="@Model.LanguageCode">
                <div class="d-flex align-items-center gap-2">
                    @if (Model.IsBreakingNews)
                    {
                        <span class="badge-breaking" lang="@lang">@L["Breaking"]</span>
                    }
                    <a class="kicker" href="@categoryUrl" lang="@lang">@categoryName</a>
                </div>
                <h1 class="article-title">@Model.Title</h1>
                <p class="article-standfirst">@Model.Summary</p>
            </header>

            <div class="byline">
                @await Html.PartialAsync("_Avatar", (authorName, AvatarOf(Model.AuthorId), "avatar-md"))
                <div>
                    <div>@L["By"] <a class="byline-link" href="@SeoUrls.Author(Model.AuthorId, authorName)"><strong>@authorName</strong></a></div>
                    <div>
                        <time datetime="@Iso(Model.PublishDate)">@Model.PublishDate.ToString("d MMMM yyyy, h:mm tt")</time>
                        @if (modified.HasValue)
                        {
                            <span class="sep">&bull;</span><span>@L["Updated"] <time datetime="@Iso(modified.Value)">@modified.Value.ToString("d MMM yyyy")</time></span>
                        }
                        <span class="sep">&bull;</span><span>@L["{0} min read", readingMinutes]</span>
                    </div>
                </div>
                @if (Model.IsPublished)
                {
                    <div class="share" aria-label="@L["Share this article"]">
                        <a href="https://www.linkedin.com/sharing/share-offsite/?url=@shareUrl" target="_blank" rel="noopener" aria-label="@L["Share on {0}", "LinkedIn"]"><i class="bi bi-linkedin"></i></a>
                        <a href="https://twitter.com/intent/tweet?url=@shareUrl&text=@shareText" target="_blank" rel="noopener" aria-label="@L["Share on {0}", "X"]"><i class="bi bi-twitter-x"></i></a>
                        <a href="https://www.facebook.com/sharer/sharer.php?u=@shareUrl" target="_blank" rel="noopener" aria-label="@L["Share on {0}", "Facebook"]"><i class="bi bi-facebook"></i></a>
                        <a href="https://wa.me/?text=@shareText%20@shareUrl" target="_blank" rel="noopener" aria-label="@L["Share on {0}", "WhatsApp"]"><i class="bi bi-whatsapp"></i></a>
                        <button type="button" data-copy-link="@absoluteUrl" aria-label="@L["Copy link"]"><i class="bi bi-link-45deg"></i></button>
                        @if (isLoggedIn)
                        {
                            @await Html.PartialAsync("_SaveButton", (Model.ArticleId, ViewBag.IsSaved as bool? == true, "bookmark-inline"))
                        }
                        else
                        {
                            <a asp-controller="Auth" asp-action="Login" asp-route-returnUrl="@path" rel="nofollow" aria-label="@L["Sign in to save this story"]" title="@L["Sign in to save this story"]"><i class="bi bi-bookmark"></i></a>
                        }
                    </div>
                }
            </div>

            @if (image != null)
            {
                <figure class="article-figure">
                    <div class="story-media">
                        <img src="@image" alt="@Model.Title" width="1200" height="675" fetchpriority="high" />
                    </div>
                </figure>
            }

            <div class="article-body" lang="@Model.LanguageCode">
                @foreach (var p in paragraphs)
                {
                    var lines = p.Split('\n');
                    <p>
                        @for (var i = 0; i < lines.Length; i++)
                        {
                            @lines[i]
                            if (i < lines.Length - 1)
                            {
                                <br />
                            }
                        }
                    </p>
                }
            </div>

            @if (Model.Tags.Count > 0)
            {
                <nav class="article-tags" aria-label="@L["Topics"]">
                    <span class="article-tags-label">@L["Topics"]</span>
                    <ul class="list-unstyled d-flex flex-wrap gap-2 mb-0">
                        @foreach (var tag in Model.Tags)
                        {
                            <li><a class="tag-chip" href="@SeoUrls.Tag(tag.TagId, tag.Slug)" rel="tag"><i class="bi bi-hash" aria-hidden="true"></i>@tag.LocalName(lang)</a></li>
                        }
                    </ul>
                </nav>
            }

            <div class="d-flex flex-wrap gap-2 mt-4">
                <a class="btn btn-outline-secondary btn-sm" href="@categoryUrl"><i class="bi bi-arrow-left"></i> @L["More in {0}", categoryName]</a>
                @if (canEdit)
                {
                    <a class="btn btn-outline-secondary btn-sm" asp-action="Edit" asp-route-id="@Model.ArticleId"><i class="bi bi-pencil"></i> @L["Edit"]</a>
                    <a class="btn btn-outline-danger btn-sm" asp-action="Delete" asp-route-id="@Model.ArticleId"><i class="bi bi-trash"></i> @L["Delete"]</a>
                }
            </div>

            @if (Model.IsPublished)
            {
                <section class="comments" aria-labelledby="comments-heading">
                    <h2 id="comments-heading" class="h4 mb-3">@L["Comments ({0})", comments.Count]</h2>

                    @if (isLoggedIn)
                    {
                        <form asp-controller="Article" asp-action="AddComment" method="post" class="mb-4">
                            <input type="hidden" name="articleId" value="@Model.ArticleId" />
                            <label for="commentText" class="visually-hidden">@L["Your comment"]</label>
                            <textarea id="commentText" name="commentText" class="form-control mb-2" rows="3" minlength="2" maxlength="500" placeholder="@L["Join the conversation"]" required></textarea>
                            <button type="submit" class="btn btn-dark"><i class="bi bi-chat-left-text"></i> @L["Post comment"]</button>
                        </form>
                    }
                    else
                    {
                        <p class="mb-4"><a asp-controller="Auth" asp-action="Login" rel="nofollow">@L["Sign in"]</a> @L["to join the conversation."]</p>
                    }

                    @if (comments.Count == 0)
                    {
                        <p class="text-muted">@L["No comments yet. Be the first to share your view."]</p>
                    }
                    @foreach (var comment in comments)
                    {
                        <div class="comment">
                            <div class="d-flex justify-content-between align-items-start gap-3">
                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                    @await Html.PartialAsync("_Avatar", (commentNames.TryGetValue(comment.CommentId, out var an) ? an : L["Reader"].Value, AvatarOf(comment.UserId), "avatar-sm"))
                                    <span class="comment-author">@(commentNames.TryGetValue(comment.CommentId, out var n) ? n : L["Reader"])</span>
                                    <span class="meta ms-2"><time datetime="@comment.CreatedDate.ToString("yyyy-MM-ddTHH:mm")">@comment.CreatedDate.ToString("d MMM yyyy, h:mm tt")</time></span>
                                </div>
                                @if (isAdmin || userId == comment.UserId)
                                {
                                    <form asp-controller="Comment" asp-action="Delete" method="post">
                                        <input type="hidden" name="id" value="@comment.CommentId" />
                                        <input type="hidden" name="articleId" value="@Model.ArticleId" />
                                        <button type="submit" class="btn btn-link btn-sm text-danger p-0">@L["Delete"]</button>
                                    </form>
                                }
                            </div>
                            <p class="mb-0 mt-1">@comment.Text</p>
                        </div>
                    }
                </section>
            }

            @if (recommendations.Count > 0)
            {
                <section class="mt-5" aria-labelledby="related-heading">
                    <div class="section-head">
                        <h2 id="related-heading">@L["Related stories"]</h2>
                    </div>
                    <div class="row g-4">
                        @foreach (var rec in recommendations)
                        {
                            <div class="col-md-6">
                                <partial name="_StoryCard" model="rec" />
                            </div>
                        }
                    </div>
                </section>
            }
        </article>

        <aside class="col-lg-4">
            <div class="sticky-aside">
                @if (latest.Count > 0)
                {
                    <div class="side-panel">
                        <h2 class="side-panel-title">@L["Latest news"]</h2>
                        @foreach (var item in latest)
                        {
                            <partial name="_StoryCompact" model="item" />
                        }
                    </div>
                }
                @if (category != null && !string.IsNullOrEmpty(category.LocalDescription(lang)))
                {
                    <div class="side-panel">
                        <h2 class="side-panel-title">@L["About {0}", categoryName]</h2>
                        <p class="small text-muted">@category.LocalDescription(lang)</p>
                        <a class="btn btn-outline-primary btn-sm" href="@categoryUrl">@L["View all {0} news", categoryName]</a>
                    </div>
                }
            </div>
        </aside>
    </div>
</div>
