@model List<BLL.DTOs.ArticleDTO>

@{
    ViewData["Title"] = L["My articles"];
    ViewData["NoIndex"] = true;
    var categories = ViewBag.CategoryNames as Dictionary<int, string> ?? new Dictionary<int, string>();
}

<div class="container py-4 py-lg-5">
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
        <header>
            <h1 class="page-title">@L["My articles"]</h1>
            <p class="page-intro mb-0">@L["Drafts, articles waiting for approval and everything you have published."]</p>
        </header>
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-pencil-square"></i> @L["Write an article"]</a>
    </div>

    <div class="row g-3 mb-4">
        @foreach (var status in new[] { ArticleStatus.Draft, ArticleStatus.Pending, ArticleStatus.Published, ArticleStatus.Rejected })
        {
            <div class="col-6 col-md-3">
                <div class="data-card">
                    <div class="label">@L[ArticleStatus.Name(status)]</div>
                    <div class="value">@Model.Count(a => a.StatusId == status)</div>
                </div>
            </div>
        }
    </div>

    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <i class="bi bi-journal-text"></i>
            <h2 class="h5 mt-3">@L["You haven't written anything yet"]</h2>
            <p><a asp-action="Create">@L["Start your first article"]</a></p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-clean">
                <thead>
                    <tr>
                        <th>@L["Article"]</th>
                        <th>@L["Section"]</th>
                        <th>@L["Language"]</th>
                        <th>@L["Status"]</th>
                        <th>@L["Last change"]</th>
                        <th class="text-end">@L["Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model)
                    {
                        <tr>
                            <td lang="@a.LanguageCode">
                                <a class="fw-semibold" href="@SeoUrls.Article(a)">@a.Title</a>
                                @if (a.StatusId == ArticleStatus.Rejected && !string.IsNullOrEmpty(a.ReviewNote))
                                {
                                    <div class="small text-danger mt-1"><i class="bi bi-chat-square-text"></i> @a.ReviewNote</div>
                                }
                            </td>
                            <td>@(categories.TryGetValue(a.CategoryId, out var c) ? c : "")</td>
                            <td>@AppLanguages.NativeName(a.LanguageCode)</td>
                            <td>
                                <span class="status-pill s-@a.StatusId">@L[a.StatusName]</span>
                                @if (a.StatusId == ArticleStatus.Scheduled && a.ScheduledAt.HasValue)
                                {
                                    <div class="meta small mt-1">@a.ScheduledAt.Value.ToString("d MMM, h:mm tt")</div>
                                }
                            </td>
                            <td class="text-nowrap">@((a.UpdatedAt ?? a.CreatedAt).ToString("d MMM yyyy"))</td>
                            <td class="text-end text-nowrap">
                                @if (a.StatusId != ArticleStatus.Published)
                                {
                                    <a asp-action="Edit" asp-route-id="@a.ArticleId" class="btn btn-sm btn-outline-secondary">@L["Edit"]</a>
                                    @if (a.StatusId == ArticleStatus.Draft || a.StatusId == ArticleStatus.Rejected)
                                    {
                                        <form asp-action="Submit" asp-route-id="@a.ArticleId" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-primary">@L["Submit"]</button>
                                        </form>
                                    }
                                    <a asp-action="Delete" asp-route-id="@a.ArticleId" class="btn btn-sm btn-link text-danger">@L["Delete"]</a>
                                }
                                else
                                {
                                    <a href="@SeoUrls.Article(a)" class="btn btn-sm btn-outline-secondary">@L["View"]</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
