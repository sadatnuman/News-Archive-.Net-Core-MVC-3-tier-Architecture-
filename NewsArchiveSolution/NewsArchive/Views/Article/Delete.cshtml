@model BLL.DTOs.ArticleDTO

@{
    ViewData["Title"] = L["Delete article"];
    ViewData["NoIndex"] = true;
}

<div class="container py-5">
    <div class="auth-card">
        <h1 class="h3 mb-3">@L["Delete this article?"]</h1>
        <p class="mb-1 fw-semibold" lang="@Model.LanguageCode">@Model.Title</p>
        <p class="text-muted small mb-4">@L[Model.StatusName] &bull; @L["{0} views", Model.ViewsCount]. @L["This cannot be undone."]</p>
        <form method="post">
            <input type="hidden" name="id" value="@Model.ArticleId" />
            <div class="d-flex gap-2">
                <button type="submit" value="Yes" name="Decision" class="btn btn-danger">@L["Yes, delete"]</button>
                <button type="submit" value="No" name="Decision" class="btn btn-outline-secondary">@L["Cancel"]</button>
            </div>
        </form>
    </div>
</div>
