@model List<BLL.DTOs.ArticleDTO>

@{
    var keyword = ViewBag.Keyword as string;
    var from = ViewBag.From as DateTime?;
    var to = ViewBag.To as DateTime?;
    var page = (int)(ViewBag.Page ?? 1);
    var pageSize = (int)(ViewBag.PageSize ?? 9);
    var total = (int)(ViewBag.Total ?? 0);
    var totalPages = (int)Math.Ceiling(total / (double)pageSize);
    var lang = UiLanguage.Current;

    var meta = ViewData.Meta();
    meta.Title = string.IsNullOrWhiteSpace(keyword) ? L["Search the news archive"] : L["Search results for “{0}”", keyword];
    meta.Description = L["Search every story in The Meridian Newsfolio by keyword and date."];
    meta.CanonicalPath = SeoUrls.Page("/search");
    meta.NoIndex = true;

    string PageUrl(int p) => SeoUrls.Page($"/search?keyword={Uri.EscapeDataString(keyword ?? "")}&from={from?.ToString("yyyy-MM-dd")}&to={to?.ToString("yyyy-MM-dd")}&page={p}");
}

<div class="container py-4 py-lg-5">
    <nav class="crumbs" aria-label="@L["Breadcrumb"]">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="@SeoUrls.Page("/")">@L["Home"]</a></li>
            <li class="breadcrumb-item active" aria-current="page">@L["Search"]</li>
        </ol>
    </nav>

    <h1 class="page-title mb-4">@meta.Title</h1>

    <form class="search-panel mb-4" action="/search" method="get" role="search">
        @if (lang != AppLanguages.English)
        {
            <input type="hidden" name="lang" value="@lang" />
        }
        <div class="row g-3 align-items-end">
            <div class="col-md-5">
                <label for="keyword" class="form-label fw-semibold">@L["Keyword"]</label>
                <input id="keyword" type="search" name="keyword" value="@keyword" class="form-control" placeholder="@L["Title, summary or text"]" maxlength="60" autocomplete="off" data-suggest="/api/search/suggest" data-lang="@lang" />
            </div>
            <div class="col-6 col-md-2">
                <label for="from" class="form-label fw-semibold">@L["From"]</label>
                <input id="from" type="date" name="from" value="@(from?.ToString("yyyy-MM-dd"))" class="form-control" />
            </div>
            <div class="col-6 col-md-2">
                <label for="to" class="form-label fw-semibold">@L["To"]</label>
                <input id="to" type="date" name="to" value="@(to?.ToString("yyyy-MM-dd"))" class="form-control" />
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1"><i class="bi bi-search"></i> @L["Search"]</button>
                <a href="@SeoUrls.Page("/search")" class="btn btn-outline-secondary">@L["Clear"]</a>
            </div>
        </div>
    </form>

    <p class="text-muted mb-4" role="status">@L["{0} stories found", total]</p>

    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <i class="bi bi-search"></i>
            <h2 class="h5 mt-3">@L["No stories match your search"]</h2>
            <p class="mb-0">@L["Try a different keyword or widen the date range."]</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <partial name="_StoryCard" model="item" />
                </div>
            }
        </div>
    }

    @if (totalPages > 1)
    {
        <nav class="mt-5" aria-label="@L["Pages"]">
            <ul class="pagination justify-content-center">
                @for (var i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == page ? "active" : "")">
                        <a class="page-link" href="@PageUrl(i)" aria-current="@(i == page ? "page" : null)">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }
</div>
