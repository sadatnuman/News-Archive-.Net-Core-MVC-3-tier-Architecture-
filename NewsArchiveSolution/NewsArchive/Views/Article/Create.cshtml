@model BLL.DTOs.ArticleFormDTO

@{
    ViewData["Title"] = "Write an article";
    ViewData["NoIndex"] = true;
    var isAdmin = ViewBag.IsAdmin as bool? ?? false;
}

<div class="container py-5">
    <div class="row g-5">
        <div class="col-lg-8">
            <h1 class="page-title mb-2">Write an article</h1>
            <p class="text-muted mb-4">
                @(isAdmin ? "Articles you publish go live immediately." : "Your article is published after an admin approves it.")
            </p>
            <partial name="_ArticleForm" model="Model" />
        </div>
        <aside class="col-lg-4">
            <partial name="_WritingTips" />
        </aside>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
