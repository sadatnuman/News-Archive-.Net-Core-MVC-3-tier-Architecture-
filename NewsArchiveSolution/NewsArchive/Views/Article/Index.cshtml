@model List<BLL.DTOs.ArticleDTO>

@{
    ViewData["Title"] = "Home - Latest Articles";
    var roleId = Context.Session.GetInt32("RoleId");
    var isAdmin = roleId == 1;
    var keyword = ViewBag.Keyword as string;
    var from = ViewBag.From as DateTime?;
    var to = ViewBag.To as DateTime?;
    var page = (int)(ViewBag.Page ?? 1);
    var pageSize = (int)(ViewBag.PageSize ?? 9);
    var total = (int)(ViewBag.Total ?? 0);
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h1 class="display-4">News Archive</h1>
            <p class="text-muted">Stay updated with the latest news and stories</p>
        </div>
        @if (isAdmin)
        {
            <a href="@Url.Action("Create", "Article")" class="btn btn-primary btn-lg">
                <i class="bi bi-plus-circle"></i> Create Article
            </a>
        }
    </div>

    <form method="get" class="mb-4">
        <div class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label">Keyword</label>
                <input type="text" name="keyword" value="@keyword" class="form-control" placeholder="Title or Content" />
            </div>
            <div class="col-md-3">
                <label class="form-label">From Date</label>
                <input type="date" name="from" value="@(from?.ToString("yyyy-MM-dd"))" class="form-control" />
            </div>
            <div class="col-md-3">
                <label class="form-label">To Date</label>
                <input type="date" name="to" value="@(to?.ToString("yyyy-MM-dd"))" class="form-control" />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">Search</button>
            </div>
        </div>
    </form>

    @if (Model != null && Model.Count > 0)
    {
        <div class="row g-4">
            @foreach (var article in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm hover-shadow transition">
                        @{
                            string imgUrl = null;
                            if (!string.IsNullOrEmpty(article.ImagePath))
                            {
                                if (article.ImagePath.StartsWith("~") || article.ImagePath.StartsWith("http"))
                                {
                                    imgUrl = Url.Content(article.ImagePath);
                                }
                                else if (article.ImagePath.StartsWith("/"))
                                {
                                    imgUrl = article.ImagePath;
                                }
                                else
                                {
                                    imgUrl = "/" + article.ImagePath;
                                }
                            }
                        }

                        @if (!string.IsNullOrEmpty(imgUrl))
                        {
                            <img src="@imgUrl" class="card-img-top" alt="@article.Title" style="height: 250px; object-fit: cover;">
                        }
                        else
                        {
                            <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 250px;">
                                <i class="bi bi-image" style="font-size: 3rem; color: #ccc;"></i>
                            </div>
                        }

                        <div class="card-body d-flex flex-column">
                            <div class="mb-2">
                                @{
                                    var categoryName = "Unknown";
                                    if (ViewBag.CategoryNames is Dictionary<int, string> catNames && catNames.TryGetValue(article.CategoryId, out var name))
                                        categoryName = name;
                                }
                                <span class="badge bg-info text-dark">@categoryName</span>
                            </div>

                            <h5 class="card-title fw-bold">@article.Title</h5>

                            <div class="text-muted small mb-2">
                                @{
                                    var authorName = "Unknown";
                                    if (ViewBag.AuthorNames is Dictionary<int, string> authors && authors.TryGetValue(article.ArticleId, out var author))
                                        authorName = author;
                                }
                                <i class="bi bi-person"></i>
                                <span>By @authorName</span>
                            </div>

                            <p class="card-text text-muted small flex-grow-1">
                                @article.Summary
                            </p>

                            <div class="text-muted small mb-3">
                                <i class="bi bi-calendar"></i> 
                                <span>@article.PublishDate.ToString("MMM dd, yyyy")</span>
                            </div>

                            <a href="@Url.Action("Details", "Article", new { id = article.ArticleId })" class="btn btn-sm btn-outline-primary">
                                Read More →
                            </a>
                        </div>

                        @if (isAdmin)
                        {
                            <div class="card-footer bg-white border-top">
                                <div class="btn-group btn-group-sm w-100" role="group">
                                    <a href="@Url.Action("Edit", "Article", new { id = article.ArticleId })" class="btn btn-outline-warning">
                                        <i class="bi bi-pencil"></i> Edit
                                    </a>
                                    <a href="@Url.Action("Delete", "Article", new { id = article.ArticleId })" class="btn btn-outline-danger">
                                        <i class="bi bi-trash"></i> Delete
                                    </a>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info text-center py-5">
            <h5>No articles found</h5>
            <p class="mb-0">Check back soon for new content</p>
        </div>
    }

    @if (total > pageSize)
    {
        <nav aria-label="Page navigation">
            <ul class="pagination justify-content-center mt-4">
                @for (int i = 1; i <= (int)Math.Ceiling((double)total / pageSize); i++)
                {
                    <li class="page-item @(i == page ? "active" : "")">
                        <a class="page-link" href="?keyword=@keyword&from=@(from?.ToString("yyyy-MM-dd"))&to=@(to?.ToString("yyyy-MM-dd"))&page=@i&pageSize=@pageSize">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }
</div>

<style>
    .hover-shadow {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .hover-shadow:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 30px rgba(0,0,0,0.15) !important;
    }
</style>