@model List<BLL.DTOs.ArticleDTO>
@using NewsArchive.Seo
@inject SeoUrls Urls

@{
    var page = (int)(ViewBag.Page ?? 1);
    var pageSize = (int)(ViewBag.PageSize ?? 9);
    var total = (int)(ViewBag.Total ?? 0);
    var totalPages = (int)Math.Ceiling(total / (double)pageSize);
    var trending = ViewBag.Trending as List<BLL.DTOs.ArticleDTO> ?? new List<BLL.DTOs.ArticleDTO>();
    var isFirstPage = page == 1;

    var meta = ViewData.Meta();
    meta.Title = isFirstPage ? null : $"Latest news – page {page}";
    meta.CanonicalPath = isFirstPage ? "/" : $"/?page={page}";
    meta.JsonLd.Add(new Dictionary<string, object?>
    {
        ["@type"] = "ItemList",
        ["itemListElement"] = Model.Select((a, i) => new Dictionary<string, object?>
        {
            ["@type"] = "ListItem",
            ["position"] = (page - 1) * pageSize + i + 1,
            ["url"] = Urls.Absolute(SeoUrls.Article(a.ArticleId, a.Slug))
        }).ToList()
    });

    var lead = isFirstPage ? Model.FirstOrDefault() : null;
    var secondary = isFirstPage ? Model.Skip(1).Take(3).ToList() : new List<BLL.DTOs.ArticleDTO>();
    var grid = isFirstPage ? Model.Skip(4).ToList() : Model;
}

@section Head {
    @if (page > 1)
    {
        <link rel="prev" href="@(page == 2 ? "/" : $"/?page={page - 1}")" />
    }
    @if (page < totalPages)
    {
        <link rel="next" href="/?page=@(page + 1)" />
    }
}

<div class="container py-4 py-lg-5">
    <h1 class="page-title mb-4">@(isFirstPage ? "Latest news and breaking stories" : $"Latest news – page {page}")</h1>

    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <i class="bi bi-newspaper"></i>
            <h2 class="h5 mt-3">No stories published yet</h2>
            <p class="mb-0">Check back soon for the latest reporting.</p>
        </div>
    }
    else
    {
        @if (lead != null)
        {
            <section class="row g-4 g-lg-5 mb-5" aria-label="Top stories">
                <div class="col-lg-8">
                    <partial name="_StoryLead" model="lead" />
                </div>
                <div class="col-lg-4">
                    @foreach (var item in secondary)
                    {
                        <partial name="_StoryCompact" model="item" />
                    }
                </div>
            </section>
        }

        <div class="row g-5">
            <section class="col-lg-8" aria-labelledby="latest-heading">
                <div class="section-head">
                    <h2 id="latest-heading">More stories</h2>
                    <a href="/search">Search the archive <i class="bi bi-arrow-right"></i></a>
                </div>
                @if (grid.Count > 0)
                {
                    <div class="row g-4">
                        @foreach (var item in grid)
                        {
                            <div class="col-md-6">
                                <partial name="_StoryCard" model="item" />
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted">You're all caught up.</p>
                }

                @if (totalPages > 1)
                {
                    <nav class="mt-5" aria-label="Pages">
                        <ul class="pagination justify-content-center">
                            @for (var i = 1; i <= totalPages; i++)
                            {
                                <li class="page-item @(i == page ? "active" : "")">
                                    <a class="page-link" href="@(i == 1 ? "/" : $"/?page={i}")" aria-current="@(i == page ? "page" : null)">@i</a>
                                </li>
                            }
                        </ul>
                    </nav>
                }
            </section>

            <aside class="col-lg-4">
                <div class="sticky-aside">
                    @if (trending.Count > 0)
                    {
                        <div class="side-panel">
                            <h2 class="side-panel-title">Trending now</h2>
                            <ol class="rank-list">
                                @foreach (var t in trending)
                                {
                                    <li><a href="@SeoUrls.Article(t.ArticleId, t.Slug)">@t.Title</a></li>
                                }
                            </ol>
                        </div>
                    }
                    <div class="side-panel">
                        <h2 class="side-panel-title">Stay informed</h2>
                        <p class="small text-muted mb-3">Follow every story as it is published with our RSS feed.</p>
                        <a class="btn btn-dark btn-sm" href="/rss.xml"><i class="bi bi-rss"></i> Subscribe via RSS</a>
                    </div>
                </div>
            </aside>
        </div>
    }
</div>
