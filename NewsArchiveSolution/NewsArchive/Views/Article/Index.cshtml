@model List<BLL.DTOs.ArticleDTO>
@inject SeoUrls Urls

@{
    var page = (int)(ViewBag.Page ?? 1);
    var pageSize = (int)(ViewBag.PageSize ?? 9);
    var total = (int)(ViewBag.Total ?? 0);
    var totalPages = (int)Math.Ceiling(total / (double)pageSize);
    var trending = ViewBag.Trending as List<BLL.DTOs.ArticleDTO> ?? new List<BLL.DTOs.ArticleDTO>();
    var isFirstPage = page == 1;
    string PagePath(int p) => SeoUrls.Page(p == 1 ? "/" : $"/?page={p}");

    var meta = ViewData.Meta();
    meta.Title = isFirstPage ? null : L["Latest news – page {0}", page].Value;
    meta.CanonicalPath = PagePath(page);
    meta.JsonLd.Add(new Dictionary<string, object?>
    {
        ["@type"] = "ItemList",
        ["itemListElement"] = Model.Select((a, i) => new Dictionary<string, object?>
        {
            ["@type"] = "ListItem",
            ["position"] = (page - 1) * pageSize + i + 1,
            ["url"] = Urls.Absolute(SeoUrls.Article(a))
        }).ToList()
    });

    var lead = isFirstPage ? Model.FirstOrDefault() : null;
    var onThisDay = ViewBag.OnThisDay as List<BLL.DTOs.ArticleDTO> ?? new List<BLL.DTOs.ArticleDTO>();
    var popularTags = ViewBag.PopularTags as List<BLL.DTOs.TagDTO> ?? new List<BLL.DTOs.TagDTO>();
    var secondary = isFirstPage ? Model.Skip(1).Take(3).ToList() : new List<BLL.DTOs.ArticleDTO>();
    var grid = isFirstPage ? Model.Skip(4).ToList() : Model;
    var forYou = ViewBag.ForYou as List<BLL.DTOs.RecommendationDTO> ?? new List<BLL.DTOs.RecommendationDTO>();
    var signedIn = User.Identity?.IsAuthenticated == true;
}

@section Head {
    @if (page > 1)
    {
        <link rel="prev" href="@PagePath(page - 1)" />
    }
    @if (page < totalPages)
    {
        <link rel="next" href="@PagePath(page + 1)" />
    }
}

<div class="container py-4 py-lg-5">
    <h1 class="page-title mb-4">@(isFirstPage ? L["Latest news and breaking stories"] : L["Latest news – page {0}", page])</h1>

    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <i class="bi bi-newspaper"></i>
            <h2 class="h5 mt-3">@L["No stories published yet"]</h2>
            <p class="mb-0">@L["Check back soon for the latest reporting."]</p>
        </div>
    }
    else
    {
        @if (lead != null)
        {
            <section class="row g-4 g-lg-5 mb-5" aria-label="@L["Top stories"]">
                <div class="col-lg-8">
                    <partial name="_StoryLead" model="lead" />
                </div>
                <div class="col-lg-4">
                    @foreach (var item in secondary)
                    {
                        <partial name="_StoryCompact" model="item" />
                    }
                </div>
            </section>
        }

        @if (forYou.Count > 0)
        {
            <section class="for-you mb-5" aria-labelledby="for-you-heading">
                <div class="section-head">
                    <h2 id="for-you-heading"><i class="bi bi-stars text-accent" aria-hidden="true"></i> @L["Recommended for you"]</h2>
                    @if (signedIn)
                    {
                        <a href="@SeoUrls.Page("/history")">@L["Your reading history"] <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
                    }
                </div>
                <p class="small text-muted mt-n2 mb-3">@L["Based on the stories you have read."]</p>
                <div class="row g-4">
                    @foreach (var rec in forYou)
                    {
                        <div class="col-sm-6 col-lg-3">
                            <partial name="_RecCard" model="rec" />
                        </div>
                    }
                </div>
            </section>
        }

        <div class="row g-4 g-lg-5">
            <section class="col-lg-8" aria-labelledby="latest-heading">
                <div class="section-head">
                    <h2 id="latest-heading">@L["More stories"]</h2>
                    <a href="@SeoUrls.Page("/search")">@L["Search the archive"] <i class="bi bi-arrow-right"></i></a>
                </div>
                @if (grid.Count > 0)
                {
                    <div class="row g-4">
                        @foreach (var item in grid)
                        {
                            <div class="col-md-6">
                                <partial name="_StoryCard" model="item" />
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted">@L["You're all caught up."]</p>
                }

                @if (totalPages > 1)
                {
                    <nav class="mt-5" aria-label="@L["Pages"]">
                        <ul class="pagination justify-content-center">
                            @for (var i = 1; i <= totalPages; i++)
                            {
                                <li class="page-item @(i == page ? "active" : "")">
                                    <a class="page-link" href="@PagePath(i)" aria-current="@(i == page ? "page" : null)">@i</a>
                                </li>
                            }
                        </ul>
                    </nav>
                }
            </section>

            <aside class="col-lg-4">
                <div class="sticky-aside">
                    @if (trending.Count > 0)
                    {
                        <div class="side-panel">
                            <h2 class="side-panel-title">@L["Trending now"]</h2>
                            <ol class="rank-list">
                                @foreach (var t in trending)
                                {
                                    <li lang="@t.LanguageCode"><a href="@SeoUrls.Article(t)">@t.Title</a></li>
                                }
                            </ol>
                        </div>
                    }
                    @if (popularTags.Count > 0)
                    {
                        <div class="side-panel">
                            <h2 class="side-panel-title">@L["Popular topics"]</h2>
                            <ul class="tag-cloud list-unstyled mb-3">
                                @foreach (var tag in popularTags)
                                {
                                    <li><a class="tag-chip" href="@SeoUrls.Tag(tag.TagId, tag.Slug)"><i class="bi bi-hash" aria-hidden="true"></i>@tag.LocalName(UiLanguage.Current)</a></li>
                                }
                            </ul>
                            <a class="small fw-semibold" href="@SeoUrls.Page("/tags")">@L["Browse all topics"] <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
                        </div>
                    }
                    <div class="side-panel">
                        <h2 class="side-panel-title">@(onThisDay.Count > 0 ? L["On this day"] : L["From the archive"])</h2>
                        @if (onThisDay.Count > 0)
                        {
                            <ul class="list-unstyled mb-3">
                                @foreach (var a in onThisDay)
                                {
                                    <li class="py-2 border-bottom" lang="@a.LanguageCode">
                                        <span class="meta d-block">@a.PublishDate.Year</span>
                                        <a href="@SeoUrls.Article(a)">@a.Title</a>
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p class="small text-muted mb-3">@L["Browse every story by year, month and day."]</p>
                        }
                        <a class="btn btn-outline-primary btn-sm" href="@SeoUrls.Page("/archive")"><i class="bi bi-calendar3"></i> @L["Browse the archive"]</a>
                    </div>
                    <div class="side-panel">
                        <h2 class="side-panel-title">@L["Stay informed"]</h2>
                        <p class="small text-muted mb-3">@L["Get the weekly digest by email, or follow every story with our RSS feed."]</p>
                        @await Html.PartialAsync("_NewsletterForm", "home")
                        <a class="btn btn-outline-secondary btn-sm mt-3" href="@SeoUrls.Page("/rss.xml")"><i class="bi bi-rss"></i> @L["Subscribe via RSS"]</a>
                    </div>
                </div>
            </aside>
        </div>
    }
</div>
