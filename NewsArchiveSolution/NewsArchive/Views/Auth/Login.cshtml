@{
    ViewData["Title"] = "Login";
}
    <style>
        .login-container {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .login-box {
            padding: 2rem;
            border: 1px solid #ddd;
            border-radius: 8px;
            background: #fff;
            box-shadow: 0 2px 8px rgba(0,0,0,0.05);
            min-width: 350px;
        }
        .login-actions {
            display: flex;
            gap: 1rem;
            margin-top: 1.5rem;
            justify-content: center;
        }
    </style>
    <div class="login-container">
        <div class="login-box">
            <h2>Login</h2>
            @if (TempData["Msg"] != null)
            {
                <div class="alert alert-@TempData["Class"]">@TempData["Msg"]</div>
            }
            <form asp-action="Login" method="post">
                <div>
                    <label>Email</label>
                    <input type="text" name="Uname" class="form-control" required />
                </div>
                <div>
                    <label>Password</label>
                    <input type="password" name="Pass" class="form-control" required />
                </div>
                <div style="text-align: center;">
                    <button type="submit" class="btn btn-primary mt-3">Login</button>
                </div>
            </form>
            <div class="login-actions">
                <a asp-action="Create" asp-controller="Auth" class="btn btn-secondary">Sign Up</a>
                <a asp-action="ForgetPassword" asp-controller="Auth" class="btn btn-warning">Forgot Password</a>
                <a asp-action="Index" asp-controller="Article" class="btn btn-secondary">Back to Home</a>
            </div>
        </div>
    </div>