@model BLL.DTOs.UserDTO

@{
    ViewData["Title"] = L["Create an account"];
    ViewData["NoIndex"] = true;
}

<div class="container">
    <div class="auth-card">
        <h1 class="h3 mb-1">@L["Create an account"]</h1>
        <p class="text-muted mb-4">@L["Join readers who follow, discuss and save the news."]</p>
        <form asp-action="Create" method="post">
            <input type="hidden" asp-for="RoleId" value="@AppRoles.Reader" />
            <input type="hidden" asp-for="CreatedAt" value="@DateTime.Now.ToString("s")" />
            <partial name="_UserFields" model="Model" />
            <button type="submit" class="btn btn-primary w-100">@L["Create account"]</button>
        </form>
        <p class="text-center small mt-4 mb-0">@L["Already have an account?"] <a asp-action="Login">@L["Sign in"]</a></p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
