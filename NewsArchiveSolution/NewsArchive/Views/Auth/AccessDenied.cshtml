@{
    var meta = ViewData.Meta();
    meta.Title = L["Access denied"];
    meta.NoIndex = true;
}

<div class="container py-5">
    <div class="text-center py-5 mx-auto" style="max-width: 36rem;">
        <div class="display-1 fw-bold serif text-accent">403</div>
        <h1 class="page-title mt-2">@meta.Title</h1>
        <p class="page-intro mx-auto">@L["Your account does not have permission to open this page."]</p>
        <div class="d-flex flex-wrap justify-content-center gap-2 mt-4">
            <a href="@SeoUrls.Page("/")" class="btn btn-dark">@L["Go to the homepage"]</a>
            <a asp-controller="Auth" asp-action="Logout" class="btn btn-outline-secondary" rel="nofollow">@L["Sign in with another account"]</a>
        </div>
    </div>
</div>
