@{
    ViewData["Title"] = L["Enter your code"];
    ViewData["NoIndex"] = true;
    var email = ViewBag.Email as string ?? Context.Request.Query["email"].ToString();
}

<div class="container">
    <div class="auth-card">
        <h1 class="h3 mb-1">@L["Enter your code"]</h1>
        <p class="text-muted mb-4">@L["We sent a 6-digit code to {0}. It expires in one minute.", email]</p>
        <form method="post" asp-action="VerifyOtp">
            <input type="hidden" name="email" value="@email" />
            <div class="mb-3">
                <label for="otp" class="form-label fw-semibold">@L["One-time code"]</label>
                <input id="otp" type="text" name="otp" class="form-control form-control-lg text-center" inputmode="numeric" autocomplete="one-time-code" maxlength="6" required />
            </div>
            <div class="d-flex justify-content-between">
                <a asp-action="ForgetPassword" class="btn btn-link px-0">@L["Send a new code"]</a>
                <button type="submit" class="btn btn-primary">@L["Verify"]</button>
            </div>
        </form>
    </div>
</div>
