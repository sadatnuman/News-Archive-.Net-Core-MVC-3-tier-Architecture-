@{
    ViewData["Title"] = "Verify OTP";
    var email = ViewBag.Email as string ?? Context.Request.Query["email"].ToString();
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title mb-3">Verify OTP</h4>

                    <form method="post" asp-action="VerifyOtp">
                        <input type="hidden" name="email" value="@email" />
                        <div class="mb-3">
                            <label class="form-label">OTP</label>
                            <input type="text" name="otp" class="form-control" maxlength="6" required />
                        </div>
                        <div class="d-flex justify-content-between">
                            <a asp-action="ForgetPassword" class="btn btn-secondary">Back</a>
                            <button type="submit" class="btn btn-primary">Verify OTP</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>