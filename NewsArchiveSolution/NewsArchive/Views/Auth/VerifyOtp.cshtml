@{
    ViewData["Title"] = "Verify OTP";
    var email = ViewBag.Email as string ?? Context.Request.Query["email"].ToString();
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title mb-3">Verify OTP</h4>

                    @if (TempData["Msg"] != null)
                    {
                        <div class="alert alert-@TempData["Class"]">@TempData["Msg"]</div>
                    }

                    <form method="post" asp-action="VerifyOtp">
                        <input type="hidden" name="email" value="@email" />
                        <div class="mb-3">
                            <label class="form-label">OTP</label>
                            <input type="text" name="otp" class="form-control" maxlength="6" required />
                        </div>
                        <div class="d-flex justify-content-between">
                            <a asp-action="ForgetPassword" class="btn btn-secondary">Back</a>
                            <button type="submit" class="btn btn-primary">Verify OTP</button>
                        </div>
                    </form>
                    <script>
                        (function () {
                            // Dev-only: read OTP from server session and print to browser console
                            var otp = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Context.Session.GetString($"PwdReset:Otp:{email}") ?? ""));
                            if (otp) {
                                console.log('OTP: ' + otp);
                            }
                        })();
                    </script>
                </div>
            </div>
        </div>
    </div>
</div>