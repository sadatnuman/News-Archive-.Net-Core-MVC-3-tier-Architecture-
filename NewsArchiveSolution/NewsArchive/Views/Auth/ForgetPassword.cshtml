@{
    ViewData["Title"] = L["Reset your password"];
    ViewData["NoIndex"] = true;
}

<div class="container">
    <div class="auth-card">
        <h1 class="h3 mb-1">@L["Reset your password"]</h1>
        <p class="text-muted mb-4">@L["Enter your account email and we will send you a one-time code."]</p>
        <form method="post" asp-action="ForgetPassword">
            <div class="mb-3">
                <label for="email" class="form-label fw-semibold">@L["Email"]</label>
                <input id="email" type="email" name="email" class="form-control" autocomplete="email" required />
            </div>
            <div class="d-flex justify-content-between">
                <a asp-action="Login" class="btn btn-link px-0">@L["Back to sign in"]</a>
                <button type="submit" class="btn btn-primary">@L["Send code"]</button>
            </div>
        </form>
    </div>
</div>
