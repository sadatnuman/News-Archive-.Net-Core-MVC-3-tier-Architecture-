@{
    var code = ViewBag.Code as int? ?? 500;
    var notFound = code == 404;
    var meta = ViewData.Meta();
    meta.Title = notFound ? "Page not found" : "Something went wrong";
    meta.NoIndex = true;
}

<div class="container py-5">
    <div class="text-center py-5 mx-auto" style="max-width: 36rem;">
        <div class="display-1 fw-bold serif text-danger">@code</div>
        <h1 class="page-title mt-2">@meta.Title</h1>
        <p class="page-intro mx-auto">
            @(notFound
                ? "The page you are looking for has moved or no longer exists."
                : "We couldn't load this page. Please try again in a moment.")
        </p>
        <form class="header-search mx-auto my-4" action="/search" method="get" role="search">
            <label for="error-search" class="visually-hidden">Search news</label>
            <i class="bi bi-search" aria-hidden="true"></i>
            <input id="error-search" type="search" name="keyword" class="form-control" placeholder="Search the archive" />
        </form>
        <a href="/" class="btn btn-dark">Go to the homepage</a>
    </div>
</div>
