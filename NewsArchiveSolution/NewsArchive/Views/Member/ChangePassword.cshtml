@model BLL.DTOs.ChangePasswordDTO
@{
    ViewBag.Title = "Change Password";
    var roles = ViewBag.Roles as IEnumerable<BLL.DTOs.RoleDTO>;
}
<form asp-action="ChangePassword" method="post" class="mt-4">
    @Html.AntiForgeryToken()
    <h4>Change Password</h4>
    <input asp-for="UserId" type="hidden" />
    <div>
        <label asp-for="Email">Email</label>
        <input asp-for="Email" class="form-control" readonly />
    </div>

    <div class="form-group">
        <label asp-for="PasswordHash">New Password</label>
        <input asp-for="PasswordHash" type="password" class="form-control" />
        <span asp-validation-for="PasswordHash" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="ConfPassword">Confirm New Password</label>
        <input asp-for="ConfPassword" type="password" class="form-control" />
        <span asp-validation-for="ConfPassword" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Change Password</button>
</form>

<a asp-action="Profile" asp-controller="Member" class="btn btn-secondary mt-3">Back to Profile</a>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}